            (0.50, (0.32, 0.04, 0.008, 0.0)),
            (1.00, (0.80, 0.20, 0.03, 0.0)),
        ],
        // Flak smoke in the air (alpha): dark grey-brown, denser than ground smoke.
        "flak_smoke": [
