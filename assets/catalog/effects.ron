        "soil_in": [(0.00, 0.00, EaseOutQuad), (1.00, 2.20, Linear)],
        "soil_hand_over": [(0.00, 0.00, EaseOutQuad), (0.25, 2.20, Linear), (0.75, 2.20, EaseInQuad), (1.00, 0.00, Linear)],
