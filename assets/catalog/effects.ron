    // Timing curves: (time 0..1, value, easing to the next key).
    curves: {
        // WP10. A billow of an area's cloud: swelling in, holding, thinning out.
        // WP10 round 3: comes in and holds at 2.5, so a held soft card is opaque out to its edges
