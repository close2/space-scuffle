        "hold_firm": [(0.00, 0.00, EaseOutQuad), (1.00, 1.60, Linear)],
        "billow": [(0.00, 0.00, EaseOutQuad), (0.25, 1.00, Linear), (0.65, 0.85, EaseInQuad), (1.00, 0.00, Linear)],
        "billow_grow": [(0.00, 0.70, EaseOutQuad), (1.00, 1.15, Linear)],
        // A storm's discharge: up in a frame, flickering down.
        "flare": [(0.00, 1.00, Linear), (0.20, 0.45, Linear), (0.35, 0.90, EaseInQuad), (1.00, 0.00, Linear)],
        // WP8. A burrowing body's sink over the morph's progress: a slow start as the shell
