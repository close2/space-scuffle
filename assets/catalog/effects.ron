        ),
        // Flame tongues licking up off a flame line (scale-out round 2): smoke-element cards
        // stretched along their rising velocity (buoyant: negative gravity), cooling to soot.
        "napalm_tongues": (
            spawn: Burst(count: (base: 3, per_unit_radius: 0.0, max: 3)), shape: Point,
            speed: (0.9, 1.9), cone_deg: 28.0, gravity: -2.5, drag: 1.4, lifetime: (0.28, 0.5),
            size: (0.10, 0.17), texture: "smoke_puff", orient: VelocityStretched(4.0),
            rotation: Mirror, ramp: "flame_tongue", size_curve: "tongue_grow", curve: "tongue_fade",
        ),
        // Dark soil clods thrown out of a heavy blow on ballistic arcs, tumbling.
        "cleave_clods": (
            spawn: Burst(count: (base: 12, per_unit_radius: 4.0, max: 16)), shape: Disc,
            speed: (3.0, 5.5), cone_deg: 50.0, gravity: 16.0, drag: 0.5, lifetime: (0.45, 0.8),
            size: (0.07, 0.14), texture: "debris_atlas", orient: Camera, rotation: Random,
            ramp: "debris", curve: "particle_fade",
        ),
        // WP8. Soil clods thrown up off the rim of a body digging in or breaking out, low and
        // short, falling back round it.
        // Review 1, B-4: larger and darker, and thrown higher and longer, so they read at the
        // default camera on a light floor.
        "burrow_clods": (
            spawn: Burst(count: (base: 8, per_unit_radius: 8.0, max: 16)), shape: Ring,
            speed: (2.0, 3.6), cone_deg: 30.0, gravity: 12.0, drag: 0.5, lifetime: (0.5, 0.85),
            size: (0.07, 0.13), texture: "debris_atlas", orient: Camera, rotation: Random,
            ramp: "clod", curve: "particle_fade",
        ),
        // WP9. The bubble's glass breaking on a death: pale shards thrown out off its rim,
        // falling, stretched along their flight.
        "glass_shards": (
            spawn: Burst(count: (base: 10, per_unit_radius: 10.0, max: 18)), shape: Ring,
            speed: (2.4, 5.0), cone_deg: 65.0, gravity: 14.0, drag: 0.8, lifetime: (0.45, 0.8),
            size: (0.035, 0.07), texture: "debris_atlas", orient: VelocityStretched(0.9),
            rotation: Random, ramp: "glass", curve: "particle_fade",
        ),
        // Dark ichor thrown out of a creature's burst body on arcs, wet-bodied and large enough
        // to read at gameplay zoom (WP9 review 1, A1-5).
        "ichor_globs": (
            spawn: Burst(count: (base: 12, per_unit_radius: 8.0, max: 18)), shape: Disc,
            speed: (2.4, 5.0), cone_deg: 50.0, gravity: 14.0, drag: 0.6, lifetime: (0.5, 0.85),
            size: (0.12, 0.24), texture: "acid_glob", orient: VelocityStretched(0.5),
            roll_deg: 90.0, ramp: "ichor", curve: "particle_fade",
        ),
        // A fine dark spray of ichor round the burst, fast and short.
        "ichor_spray": (
            spawn: Burst(count: (base: 16, per_unit_radius: 0.0, max: 16)), shape: Disc,
            speed: (3.0, 6.0), cone_deg: 70.0, gravity: 12.0, drag: 1.4, lifetime: (0.25, 0.45),
            size: (0.04, 0.08), texture: "droplet", orient: VelocityStretched(1.4),
            roll_deg: 90.0, ramp: "ichor", curve: "particle_fade",
        ),
        // Burning coals left in a wreck: small hot points lying in the scorch, cooling and
        // flickering out over one to two seconds.
        "wreck_coals": (
            spawn: Burst(count: (base: 12, per_unit_radius: 10.0, max: 20)), shape: Disc,
            speed: (0.05, 0.3), cone_deg: 80.0, gravity: 0.0, drag: 4.0, lifetime: (1.2, 2.2),
            size: (0.05, 0.1), texture: "droplet", orient: Camera, rotation: Random,
            ramp: "coal", curve: "coal_flicker",
        ),
        // Heavy dark hull wreckage thrown out of a destroyed vehicle, larger than a shell's
        // rock chunks (WP9 review 1, P1-2).
        "wreck_chunks": (
            spawn: Burst(count: (base: 6, per_unit_radius: 4.0, max: 10)), shape: Disc,
            speed: (2.5, 5.0), cone_deg: 50.0, gravity: 16.0, drag: 0.4, lifetime: (0.6, 0.95),
            size: (0.09, 0.17), texture: "debris_atlas", orient: Camera, rotation: Random,
            ramp: "clod", curve: "particle_fade",
        ),
        // Dirt and rock chips thrown up where a spine breaks the ground.
        "spine_chips": (
            spawn: Burst(count: (base: 4, per_unit_radius: 0.0, max: 4)), shape: Point,
            speed: (2.0, 3.6), cone_deg: 40.0, gravity: 14.0, drag: 0.5, lifetime: (0.30, 0.55),
            size: (0.035, 0.06), texture: "debris_atlas", orient: Camera, rotation: Random,
            ramp: "debris", curve: "particle_fade",
        ),
    },
    effects: {
        // Siege-Tank analogue, sieged: a shell detonating. The shock front races out to the
        // reach (Critical) and is drawn over the fireball's base; a charred core marks the
        // full-damage zone and a scoured blast mark the reach for 8 s; flash, light, fireball
        // cluster, sparks, debris, a dust ring and smoke carry the look (§5.5).
        // Zones of the sieged weapon: 0.47 / 0.78 / 1.25.
        "shell_impact": (
            class: Major,
            event: Splash,
            // The draw review round 5 accepted (its salt was then its dense id, 2): other draws
            // can thin the scoured blast mark at the reach (scale-out review 1).
            seed: Some(2),
            layers: [
                (
                    block: Light(color: (1.0, 0.55, 0.25), intensity: 90000.0, height: 0.9),
                    size: (bind: SplashReach, scale: 4.0), duration: 0.30, curve: "flash",
                ),
                (
                    // The flash: a soft radial glow, white core and warm halo, two frames.
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_flash", shape: Radial,
                        lift: 0.5, soft_depth: 0.4, sort_bias: 4.0,
                        breakup: (noise: "noise_tile", scale: 1.5, amount: 0.3, softness: 0.25)),
                    size: (bind: SplashReach, scale: 0.85), size_curve: "flash_grow",
                    duration: 0.09, curve: "flash",
                ),
                (
                    // The fireball: three overlapping flipbook cards of their own rotation,
                    // size and noise phase, so no two bursts share a silhouette; self-shaded
                    // (thin lobes dark, no bright rims), pushing out and cooling.
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_fire",
                        soft_depth: 0.5, rotation: Random, erosion: "erode_late", lift: 0.55,
                        breakup: (noise: "noise_tile", scale: 1.3, amount: 0.35, softness: 0.14, shade: 0.7)),
                    placement: Disc(count: 3, radius: (bind: SplashFull, scale: 0.4)),
                    size: (bind: SplashReach, scale: 0.68), size_jitter: 0.2, size_curve: "fireball_grow",
                    ramp_curve: "cool", duration: 0.85, curve: "punch",
                ),
                (
                    // The shock front: noise-broken, brightest at its leading edge, thinning
                    // as it races out to the reach; sorted over the fireball standing on it.
                    block: Ring(texture: "fireball_flipbook", ramp: "blast_ring", orient: Ground,
                        thickness: 0.45, mapping: Front, height: 0.03, sort_bias: 4.0,
                        erosion: "front_break",
                        breakup: (noise: "noise_tile", scale: 5.0, amount: 0.5, softness: 0.15)),
                    radius: (from: (bind: SplashFull, scale: 0.6), to: (bind: SplashReach, scale: 1.0),
                        curve: "front_fast"),
                    size_curve: "thin_out", duration: 0.36, curve: "front_fade", priority: Critical,
                ),
                (
                    // Dust kicked outward along the ground just behind the front.
                    block: Sprite(texture: "smoke_puff", ramp: "blast_dust", soft_depth: 0.12,
                        rotation: Random, erosion: "erode_rise", lift: 0.75, spread: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.4, softness: 0.2, shade: 0.4)),
                    placement: Disc(count: 9, radius: (bind: SplashMid, scale: 0.9)),
                    // Starts as the shock front leaves the reach (review round 4: no haze inside
                    // the ring while it races out).
                    size: (bind: SplashReach, scale: 0.26), size_jitter: 0.3, size_curve: "dust_grow",
                    start: 0.12, duration: 0.86, curve: "puff_fade",
                ),
                (block: Particles(emitter: "blast_sparks"), size: (scale: 0.1)),
                (block: Particles(emitter: "debris_chunks"), size: (bind: SplashFull, scale: 0.5), start: 0.02),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "blast_smoke", soft_depth: 0.6,
                        rotation: Random, erosion: "erode_rise", drift: (0.0, 0.45, 0.0), lift: 0.4,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.35, softness: 0.2, shade: 0.5)),
                    placement: Disc(count: 4, radius: (bind: SplashFull, scale: 1.0)),
                    size: (bind: SplashReach, scale: 0.55), size_curve: "smoke_grow", size_jitter: 0.25,
                    start: 0.14, duration: 1.9, curve: "puff_fade",
                ),
                (
                    // Embers glowing in the crater for a moment.
                    block: Decal(texture: "scorch", ramp: "ember", erosion: "erode_rise", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.5, softness: 0.2)),
                    size: (bind: SplashFull, scale: 1.3), start: 0.02, duration: 1.1, curve: "flash",
                ),
                (
                    // The charred core: the full-damage zone.
                    block: Decal(texture: "scorch", ramp: "char", erosion: "erode_tail", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.4, softness: 0.12)),
                    size: (bind: SplashFull, scale: 1.15), size_jitter: 0.06,
                    start: 0.03, duration: 8.0, curve: "linger",
                ),
                (
                    // The scoured blast mark: radial soot streaks feathering out at the reach.
                    // Round 5: it comes in once the shock ring has passed the reach (0.12 s), so
                    // no grey veil lies inside the ring while it races out; it ends as before.
                    block: Decal(texture: "blast_mark", ramp: "scour", erosion: "erode_tail", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.3, softness: 0.15)),
                    size: (bind: SplashReach, scale: 1.22), size_jitter: 0.04,
                    start: 0.12, duration: 7.91, curve: "linger",
                ),
            ],
        ),
        // Baneling analogue: an acid burst (review round 4). A dark wet splash crown, a short hot
        // core and dark-bodied globs thrown up on arcs, pale fumes rising off the stain, the acid
        // front racing to the reach (Critical) as a dark wet lip, and one liquid stain over the
        // whole disc (Critical) from the first frame, with a darker wet rim at every age, that
        // keeps its relief as it dries to an olive crust by about 1.8 s, holds the full disc
        // until then and erodes from its edge and from holes.
        "acid_burst": (
            class: Major,
            event: Splash,
            layers: [
                (
                    block: Light(color: (0.45, 1.0, 0.25), intensity: 60000.0, height: 1.0),
                    size: (bind: SplashReach, scale: 3.0), duration: 0.30, curve: "flash",
                ),
                (
                    // The burst (round 3, replacing the bevelled glow dome): the splash crown
                    // flipbook as liquid matter (dark wet body, lime highlights), torn by
                    // coarse noise so its edge is ragged, thrown up and gone by 0.35 s.
                    // Round 4: an opaque dark wet body (its own ramp), larger from frame 0 and
                    // thrown higher, so the crown reads in the air at default zoom.
                    // Round 5: larger (1.3 of the reach) and torn harder, a splash crown over the
                    // whole burst rather than a small central tuft.
                    block: Sprite(texture: "acid_crown", ramp: "acid_crown", lift: 0.6,
                        soft_depth: 0.4, rotation: Mirror, erosion: "glow_break",
                        breakup: (noise: "noise_tile", scale: 3.0, amount: 0.7, softness: 0.12, shade: 0.45)),
                    size: (bind: SplashReach, scale: 1.3), size_jitter: 0.12, size_curve: "burst_grow",
                    duration: 0.42, curve: "punch",
                ),
                (
                    // The hot core of the burst for two to three frames: a small glow, broken
                    // hard by noise so it never reads as a disc.
                    block: Sprite(texture: "droplet", ramp: "acid_glow", shape: Radial, lift: 0.3,
                        soft_depth: 0.5, erosion: "glow_break",
                        breakup: (noise: "noise_tile", scale: 3.0, amount: 0.65, softness: 0.15)),
                    size: (bind: SplashReach, scale: 0.2), size_curve: "flash_grow",
                    duration: 0.08, curve: "flash",
                ),
                (
                    // The wet lip racing to the reach. Scale-out polish (Amendment 4): it starts at
                    // 0.3 of the full-damage radius, under the crown, so frame 0 shows no
                    // concentric inner ring.
                    block: Ring(texture: "droplet", ramp: "acid_front", orient: Ground,
                        thickness: 0.40, mapping: Front, height: 0.04, erosion: "front_break",
                        breakup: (noise: "noise_tile", scale: 6.0, amount: 0.6, softness: 0.15)),
                    radius: (from: (bind: SplashFull, scale: 0.3), to: (bind: SplashReach, scale: 1.0),
                        curve: "front"),
                    size_curve: "thin_out", duration: 0.42, curve: "lip_thick", priority: Critical,
                ),
                (
                    // A thin dark rim under the front's leading edge.
                    block: Ring(texture: "droplet", ramp: "acid_edge", orient: Ground,
                        thickness: 0.07, mapping: Front, height: 0.02, erosion: "front_break",
                        breakup: (noise: "noise_tile", scale: 6.0, amount: 0.65, softness: 0.15)),
                    radius: (from: (bind: SplashFull, scale: 0.3), to: (bind: SplashReach, scale: 1.0),
                        curve: "front"),
                    duration: 0.42, curve: "hold",
                ),
                // Round 4: thrown from across the burst (a disc of half the reach), which also keeps
                // the full count at default zoom (the particle level of detail reads this size).
                (block: Particles(emitter: "acid_globs"), size: (bind: SplashReach, scale: 0.5)),
                (block: Particles(emitter: "acid_spray"), size: (bind: SplashReach, scale: 0.4)),
                (
                    // Vapour: a soft, low cloud over the centre, rising and spreading, gone
                    // by 1 s.
                    // Round 4: pale fumes over the stain, rising fast (2.2 units per second)
                    // from several places, so they read as rising and not as a smudge on it.
                    // Round 5: thinner wisps (smaller, broken harder by noise) in a faint
                    // yellow-green.
                    block: Sprite(texture: "smoke_puff", ramp: "acid_vapour", soft_depth: 0.3,
                        rotation: Random, erosion: "erode_rise", lift: 0.9, spread: 0.2,
                        drift: (0.0, 2.2, 0.0),
                        breakup: (noise: "noise_tile", scale: 1.0, amount: 0.55, softness: 0.25, shade: 0.4)),
                    placement: Disc(count: 5, radius: (bind: SplashReach, scale: 0.4)),
                    size: (bind: SplashReach, scale: 0.2), size_curve: "smoke_grow", size_jitter: 0.3,
                    start: 0.14, duration: 1.2, curve: "puff_fade",
                ),
                (
                    // The stain: one irregular wet mark over the damaged disc, drawn as a
                    // liquid (round 3): noise pools its value and thickness, the key light
                    // from the upper left gives it relief and a wet sheen, and both dry away
                    // with the ramp curve from about 0.4 s. Critical: when the crowd budget
                    // retires the Detail layers, the stain stays and marks the area.
                    block: Decal(texture: "acid_stain", ramp: "acid_stain", erosion: "stain_dry", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.45, softness: 0.14, shade: 0.25),
                        liquid: (relief: 0.4, sheen: 1.6, gloss: 30.0, value_noise: 0.75, dry_below: 0.5),
                        outline: (edge_noise: 0.02, fill: 0.76)),
                    // Round 5: as a Critical layer the stain marks the reach itself (plan
                    // §10.2), so its visible edge is a disc outline whose shallow noise wavers
                    // by about ±2 % of the radius (about ±2 px at default zoom), not the
                    // texture's ragged outline and deep noise bites (round 4: the visible edge
                    // lay at 0.87 of the reach while the box was 0.98). Sized so that the mean
                    // edge lies on the reach (about 1 / (1 - edge_noise), measured: 1.01 left the
                    // held edge a mean 1.4 px inside it on lavapipe) and its peaks within 2 px; the
                    // deep bites come only with the drying erosion after about 1.8 s.
                    size: (bind: SplashReach, scale: 1.025), size_curve: "stain_spread",
                    ramp_curve: "dry", duration: 6.0, curve: "stain_in", priority: Critical,
                ),
                (
                    // The wet glowing centre for the first moment.
                    block: Sprite(texture: "droplet", ramp: "acid_glow", shape: Radial, orient: Ground,
                        lift: 0.06, erosion: "glow_break",
                        breakup: (noise: "noise_tile", scale: 1.5, amount: 0.4, softness: 0.25)),
                    size: (bind: SplashReach, scale: 0.4), start: 0.05, duration: 1.0, curve: "glow_out",
                ),
            ],
        ),
        // Lurker analogue (round 4): a massive clump of heavy chitin spikes in a collar of torn
        // soil erupts at each search point, one point after another; each is announced a frame
        // ahead by the ground tearing open along the line, and the newest clump is lit
        // bone-ivory for its first frames with a short, light dust burst (the travelling focal
        // point). They overshoot, settle and sink back. One broken scar of torn earth and the
        // fissure stay, feathered over 0.3 at both ends. Every layer is cut off at the line's
        // first and last search points, and where the viewer's fog begins (the run of seen
        // points, R6): the first
        // point lies 1.0 from the attacker's centre, just beyond its body (radius 0.9375), so
        // nothing is drawn on or behind a burrowed attacker (D-5); the line shows wherever the
        // viewer sees it (Amendment 2, R6).
        // Travel: one spine every 0.125 Normal s = 0.089 s at Faster (B-85), 1 unit apart.
        "spine_line": (
            class: Major,
            event: Line,
            layers: [
                (
                    // The scar: torn, upturned earth stretched along the line, each piece longer
                    // than the spacing so the pieces merge into one broken scar of uneven width
                    // (never a row of patches). Critical: with the fissure it marks the line
                    // after the spines have sunk; feathered over 0.3 at the line's ends.
                    // Round 4: the box three times as wide (the furrow about 0.3 to 0.4 across) and its own
                    // ramp, so the torn-earth texture reads instead of a pencil line.
                    // Scale-out polish (Amendment 4): scattered 0.3 along and across the line, so
                    // its blotches no longer repeat at the point spacing.
                    block: Decal(texture: "earth_scar", ramp: "scar", erosion: "erode_tail", depth: 0.6,
                        yaw: AlongLine, width: 1.3, clip_to_line: true, clip_feather: 0.3,
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.3, softness: 0.15)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2, scatter: 0.3),
                    size: (bind: LineSpacing, scale: 0.95), size_jitter: 0.25,
                    duration: 2.3, curve: "linger", priority: Critical,
                ),
                (
                    // The ground heaving around each eruption over the full-damage disc: a
                    // noise-broken patch of churned soil that comes with the crack and erodes
                    // away within 0.7 s, so it marks the point that hits without leaving a row of
                    // patches behind (the scar stays).
                    block: Decal(texture: "scorch", ramp: "churn", erosion: "erode_rise", depth: 0.6,
                        clip_to_line: true, clip_feather: 0.3,
                        breakup: (noise: "noise_tile", scale: 1.8, amount: 0.5, softness: 0.2)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2, scatter: 0.08),
                    size: (bind: SplashFull, scale: 1.35), size_jitter: 0.2,
                    duration: 0.7, curve: "punch",
                ),
                (
                    // The ground tearing open at each point, two frames before its spines
                    // (round 4): a short, wide, ragged tear of torn earth running along the
                    // line, never across it, soft-edged and lower in contrast than a crack, of
                    // its own size and offset, gone with the spines.
                    block: Decal(texture: "earth_scar", ramp: "rupture", erosion: "erode_tail", depth: 0.6,
                        clip_to_line: true, clip_feather: 0.3, yaw: AlongLine, width: 0.9,
                        breakup: (noise: "noise_tile", scale: 1.5, amount: 0.45, softness: 0.25)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2, scatter: 0.1),
                    size: (bind: LineSpacing, scale: 0.42), size_jitter: 0.3,
                    duration: 1.0, curve: "linger",
                ),
                (
                    // The fissure joining the points, feathered over 0.3 at the line's ends.
                    block: Decal(texture: "ground_crack", ramp: "crack", erosion: "erode_tail",
                        depth: 0.6, yaw: AlongLine, width: 0.5, clip_to_line: true, clip_feather: 0.3,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.3, softness: 0.12)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2, between: true),
                    size: (bind: LineSpacing, scale: 1.1),
                    start: 0.03, duration: 2.5, curve: "linger", priority: Critical,
                ),
                (
                    // The clump at each point: three to five spikes splayed from one base, of
                    // its own variant, mirror, lean and height; the newest lit bone-ivory as
                    // the travelling front for its first frames.
                    // Round 4: massive clumps (wide-based spikes, lit left and shadowed right
                    // flanks, a soil collar at the root; texture_review.md, round 4), larger and
                    // standing higher, so they read at 0.6 to 0.9 units at default zoom.
                    // Round 5: a clump at the line's first or last point is made smaller and
                    // moved inward so that it stands whole inside the line instead of being cut
                    // into a lone spike (runtime), and it fades over the last 15 % of its life
                    // as it sinks, so no dark tip lingers at the ground.
                    block: Sprite(texture: "chitin_clump", ramp: "spine_chitin", orient: Upright,
                        soft_depth: 0.06, rotation: Mirror, lean_deg: 6.0, lift_curve: "spine_lift",
                        clip_to_line: true,
                        breakup: (noise: "noise_tile", scale: 1.0, amount: 0.0, softness: 0.08, shade: 0.2)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2, scatter: 0.06),
                    size: (bind: LineSpacing, scale: 0.9), size_jitter: 0.12, size_curve: "spine_pop",
                    ramp_curve: "spine_hot", start: 0.06, duration: 0.95, curve: "hold", priority: Critical,
                ),
                (
                    // The light dust burst of the newest eruption: short, pale, thrown outward.
                    block: Sprite(texture: "smoke_puff", ramp: "dust_light", soft_depth: 0.2, rotation: Random,
                        erosion: "erode_rise", lift: 0.3, spread: 0.5, clip_to_line: true,
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.45, softness: 0.2, shade: 0.4)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2),
                    size: (bind: LineSpacing, scale: 0.3), size_jitter: 0.25, size_curve: "dust_grow",
                    start: 0.06, duration: 0.32, curve: "puff_fade",
                ),
                (
                    // Dirt settling after the eruption, low and faint.
                    block: Sprite(texture: "smoke_puff", ramp: "dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.35, spread: 0.25, clip_to_line: true,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2, scatter: 0.15),
                    size: (bind: LineSpacing, scale: 0.26), size_jitter: 0.3, size_curve: "dust_grow",
                    start: 0.12, duration: 0.7, curve: "puff_fade",
                ),
                (
                    block: Particles(emitter: "spine_chips", clip_to_line: true),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 11.2),
                    size: (bind: LineSpacing, scale: 0.1), start: 0.05,
                ),
            ],
        ),
        // Hellion analogue (`napalm_wheeler`, WP7; scale-out round 2): a jet of burning napalm
        // racing from the first search point to the line's end in about 0.14 s (its search
        // line: 25 points from 0.25 to 6.5 units ahead, radius 0.15). A saturated orange jet
        // (Critical, a ribbon whose head races out at 40 units per second; yellow-white only on
        // its axis for its first two frames) inside a broken body of fire, flame tongues licking
        // up off the line and cooling to soot, burning droplets, napalm embers on the ground for
        // half a second and one continuous scorched band of uneven width (Critical) for 3 s.
        // Every layer is cut at the line's ends (nothing behind the first point: the attacker's
        // nose) and stays on the points the viewer sees (no light at its anchor: R6).
        "flame_line": (
            class: Major,
            event: Line,
            layers: [
                (
                    // The scorched band: torn, burnt ground stretched along the line, each piece
                    // more than twice the spacing long and of its own width, so they merge into
                    // one band of uneven width (not a row of beads); in as the jet passes.
                    // Critical: it marks the line after the fire has gone.
                    block: Decal(texture: "earth_scar", ramp: "scorch_band", erosion: "erode_tail", depth: 0.6,
                        yaw: AlongLine, width: 1.3, clip_to_line: true, clip_feather: 0.12,
                        breakup: (noise: "noise_tile", scale: 1.15, amount: 0.35, softness: 0.2)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 2.0), travel: 40.0, scatter: 0.1),
                    size: (bind: LineSpacing, scale: 2.4), size_jitter: 0.3,
                    start: 0.02, duration: 3.0, curve: "linger", priority: Critical,
                ),
                (
                    // Napalm burning on the band for a moment: embers glowing in the torn ground,
                    // broken by the fire noise, cooling and eroding by 0.6 s.
                    block: Decal(texture: "earth_scar", ramp: "napalm_ember", erosion: "erode_rise", depth: 0.6,
                        yaw: AlongLine, width: 1.1, clip_to_line: true, clip_feather: 0.12,
                        breakup: (noise: "fire_noise", scale: 2.3, amount: 0.65, softness: 0.25)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 2.0), travel: 40.0, scatter: 0.12),
                    size: (bind: LineSpacing, scale: 2.0), size_jitter: 0.3,
                    // Critical (Amendment 7): when a crowd of effects retires the jet's detail,
                    // the burning ground along its line still reads as fire.
                    ramp_curve: "cool", start: 0.03, duration: 0.6, curve: "glow_cool", priority: Critical,
                ),
                (
                    // The jet: racing out from the first search point, its tail leaving it after
                    // 0.12 s, the fire noise streaming along it. Saturated orange with an opaque
                    // body, yellow-white on its axis only while it is young. Critical: it is the
                    // line's path while it burns.
                    block: Ribbon(texture: "droplet", ramp: "flame_core", shape: Radial, travel: 40.0,
                        tail_delay: Some(0.12), taper: (0.4, 0.3), height: 0.3, repeat: 0.9,
                        scroll: 4.0, soft_depth: 0.2, erosion: "flame_break",
                        breakup: (noise: "fire_noise", scale: 2.5, amount: 0.6, softness: 0.3)),
                    size: (bind: SplashFull, scale: 1.0), size_curve: "flash_grow",
                    ramp_curve: "flame_cool", duration: 0.3, curve: "jet", priority: Critical,
                ),
                (
                    // The body of fire around the jet: wider, orange where dense, oxblood and
                    // soot where thin, eroding softly from its thin parts (no lit rims).
                    block: Ribbon(texture: "droplet", ramp: "flame_sheath", shape: Radial, travel: 40.0,
                        tail_delay: Some(0.2), taper: (0.45, 0.25), height: 0.34, repeat: 1.1,
                        scroll: 3.0, soft_depth: 0.3, erosion: "flame_break",
                        breakup: (noise: "fire_noise", scale: 3.0, amount: 0.8, softness: 0.35, shade: 0.5)),
                    // Critical (Amendment 7): with the jet's core it is the fire that always draws,
                    // so a jet stripped of its detail in a crowd is a poorer flame, not a beam.
                    size: (bind: SplashFull, scale: 2.4), size_curve: "flame_grow",
                    duration: 0.42, curve: "jet", priority: Critical,
                ),
                (
                    // Rolling fire on the line every other point: soft-edged billows of the
                    // smoke element in the fire's ramp, each of its own rotation, size and phase,
                    // cooling to soot and eroding softly (no holes with lit rims).
                    block: Sprite(texture: "smoke_puff", ramp: "flame_tongue", soft_depth: 0.3,
                        rotation: Random, erosion: "erode_late", lift: 0.45, drift: (0.0, 0.7, 0.0),
                        sort_bias: 0.3, clip_to_line: true,
                        breakup: (noise: "noise_tile", scale: 1.1, amount: 0.35, softness: 0.35, shade: 0.55)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 2.0), travel: 40.0, scatter: 0.12,
                        delay_jitter: 0.05),
                    size: (bind: SplashFull, scale: 2.4), size_jitter: 0.35, size_curve: "flame_grow",
                    ramp_curve: "flame_die", duration: 0.55, curve: "punch",
                ),
                (
                    // Flame tongues licking up off every point: smoke-element cards stretched
                    // along their rising velocity, born hot and cooling to soot as they rise.
                    block: Particles(emitter: "napalm_tongues", clip_to_line: true),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 40.0, scatter: 0.05),
                    // The burst's radius for its level of detail: two units across, so a jet
                    // at the default zoom keeps about half its tongues.
                    size: (bind: LineSpacing, scale: 4.0), start: 0.01,
                ),
                (
                    // Smoke rising off the burnt line, thin and late.
                    block: Sprite(texture: "smoke_puff", ramp: "blast_smoke", soft_depth: 0.5,
                        rotation: Random, erosion: "erode_rise", drift: (0.12, 0.7, 0.04), lift: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.5)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 4.0), travel: 40.0, scatter: 0.35,
                        delay_jitter: 0.3),
                    size: (bind: SplashFull, scale: 2.2), size_jitter: 0.5, size_curve: "smoke_grow",
                    start: 0.3, duration: 1.4, curve: "puff_fade",
                ),
                (
                    block: Particles(emitter: "napalm_embers", clip_to_line: true),
                    placement: Line(spacing: (bind: LineSpacing, scale: 3.0), travel: 40.0),
                    size: (bind: LineSpacing, scale: 3.0), start: 0.04,
                ),
                (
                    // Heat haze over the burning line.
                    block: Distortion(noise: "fire_noise", scale: 1.2, scroll: (0.1, 1.1),
                        strength: 0.06, height: 0.5),
                    placement: Line(spacing: (bind: LineSpacing, scale: 6.0), travel: 40.0),
                    size: (bind: LineSpacing, scale: 4.0), start: 0.03, duration: 1.1,
                    curve: "glow_out",
                ),
            ],
        ),
        // Colossus analogue (`tripod_annihilator`, WP7; scale-out round 2): a thermal lance
        // sweeping across the struck point (its search line: 11 points from -1.25 to 1.25
        // across the attack, radius 0.15). A white-hot, noise-broken stroke on the ground
        // (Critical) sweeps from one end to the other in about 0.2 s, a ragged flare at each
        // point it reaches and molten spatter thrown off it (the travelling focal point); it
        // leaves a burnt groove of uneven width with ragged edges (Critical) in a fading
        // scorched halo, glowing from the inside and through short cracks as it cools, and
        // smoke of uneven puffs drifting off it, all eroded within 2.5 s. Two strikes of one
        // attack land on one tick along the same line and draw one sweep.
        "lance_sweep": (
            class: Major,
            event: Line,
            layers: [
                (
                    // The scorched halo either side of the groove: a soft, broken darkening that
                    // fades out before the groove does.
                    block: Decal(texture: "scorch", ramp: "scorch_halo", erosion: "erode_rise", depth: 0.6,
                        yaw: AlongLine, width: 0.55, clip_to_line: true, clip_feather: 0.15,
                        breakup: (noise: "noise_tile", scale: 1.3, amount: 0.5, softness: 0.35)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 2.0), travel: 12.0, between: true,
                        scatter: 0.06),
                    size: (bind: LineSpacing, scale: 2.4), size_jitter: 0.3,
                    start: 0.03, duration: 2.0, curve: "linger",
                ),
                (
                    // The burnt groove: torn, burnt ground along the line, each piece of its own
                    // length and width (about twofold), so its edges are ragged and its width
                    // varies. Critical: it marks the line once the stroke has gone.
                    block: Decal(texture: "earth_scar", ramp: "scorch_band", erosion: "erode_tail", depth: 0.6,
                        yaw: AlongLine, width: 1.4, clip_to_line: true, clip_feather: 0.08,
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.35, softness: 0.2)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 2.0), travel: 12.0, between: true,
                        scatter: 0.05),
                    size: (bind: LineSpacing, scale: 2.0), size_jitter: 0.45,
                    start: 0.02, duration: 2.5, curve: "linger", priority: Critical,
                ),
                (
                    // The groove glowing cherry red from inside: its thin parts erode first, so
                    // the glow shrinks into the groove's middle as it cools.
                    block: Decal(texture: "earth_scar", ramp: "lance_glow", erosion: "erode_rise", depth: 0.6,
                        yaw: AlongLine, width: 0.9, clip_to_line: true, clip_feather: 0.08,
                        breakup: (noise: "fire_noise", scale: 2.0, amount: 0.45, softness: 0.25)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 2.0), travel: 12.0, between: true,
                        scatter: 0.04),
                    size: (bind: LineSpacing, scale: 1.5), size_jitter: 0.3,
                    ramp_curve: "cool", start: 0.01, duration: 1.1, curve: "glow_cool",
                ),
                (
                    // Short glowing cracks in the groove that outlast its glow by a few tenths
                    // of a second.
                    block: Decal(texture: "ground_crack", ramp: "lance_glow", erosion: "erode_rise", depth: 0.6,
                        yaw: AlongLine, width: 0.5, clip_to_line: true, clip_feather: 0.08,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.4, softness: 0.2)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 3.0), travel: 12.0, between: true,
                        scatter: 0.08),
                    size: (bind: LineSpacing, scale: 1.4), size_jitter: 0.3,
                    ramp_curve: "cool", start: 0.06, duration: 1.5, curve: "glow_cool",
                ),
                (
                    // The stroke: a white-hot segment on the ground sweeping along the line,
                    // torn by the fire noise and pointed at its tail. Critical: it is the line's
                    // path while the lance burns.
                    block: Ribbon(texture: "droplet", ramp: "lance_hot", shape: Radial, orient: Ground,
                        travel: 12.0, tail_delay: Some(0.07), taper: (0.5, 0.05), height: 0.04,
                        repeat: 0.35, scroll: 2.0, erosion: "torch_break",
                        breakup: (noise: "fire_noise", scale: 1.5, amount: 0.8, softness: 0.2)),
                    size: (bind: SplashFull, scale: 0.7), ramp_curve: "cool_fast",
                    duration: 0.3, curve: "hold", priority: Critical,
                ),
                (
                    // The flare at each point the stroke reaches: the travelling focal point,
                    // a hot, noise-broken burst rather than a disc.
                    block: Sprite(texture: "droplet", ramp: "lance_hot", shape: Radial, lift: 0.3,
                        soft_depth: 0.3, rotation: Random, erosion: "glow_break",
                        breakup: (noise: "fire_noise", scale: 2.6, amount: 0.6, softness: 0.25)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 12.0, scatter: 0.04),
                    size: (bind: SplashFull, scale: 2.3), size_jitter: 0.35, size_curve: "flash_grow",
                    duration: 0.13, curve: "flash",
                ),
                (
                    // Molten spatter thrown off every point as the stroke passes over it.
                    block: Particles(emitter: "lance_sparks", clip_to_line: true),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.0), travel: 12.0),
                    // The burst's radius for its level of detail: a point spits all its
                    // spatter at the close zoom and about a third at the default zoom.
                    size: (bind: LineSpacing, scale: 3.0),
                ),
                (
                    // Smoke drifting up off the burnt line: puffs of their own size, place and
                    // time, so they never stand in a row.
                    block: Sprite(texture: "smoke_puff", ramp: "blast_smoke", soft_depth: 0.4,
                        rotation: Random, erosion: "erode_rise", drift: (0.15, 0.55, 0.06), lift: 0.5,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.5, softness: 0.2, shade: 0.5)),
                    placement: Line(spacing: (bind: LineSpacing, scale: 1.5), travel: 12.0, scatter: 0.3,
                        delay_jitter: 0.4),
                    size: (bind: SplashFull, scale: 1.5), size_jitter: 0.6, size_curve: "smoke_grow",
                    start: 0.15, duration: 1.2, curve: "puff_fade",
                ),
                (
                    // Heat haze rising off the burnt line: the ground behind it shimmers.
                    block: Distortion(noise: "fire_noise", scale: 1.4, scroll: (0.1, 0.9),
                        strength: 0.07, height: 0.35),
                    placement: Line(spacing: (bind: LineSpacing, scale: 4.0), travel: 12.0),
                    size: (bind: LineSpacing, scale: 3.0), start: 0.05, duration: 1.0,
                    curve: "glow_out",
                ),
            ],
        ),
        // Liberator analogue's anti-air rockets (`sky_bastion`, air weapon, WP7): a flak burst
        // in the air plane of the air units it hits (splash 1.5, one zone). A flash, a fireball
        // cluster, a horizontal shock front racing to the reach in the air units' plane
        // (Critical: the area struck), burning fragments falling and a dark smoke cloud that
        // drifts and thins. No ground mark: it bursts in the air.
        "flak_burst": (
            class: Major,
            event: Splash,
            layers: [
                (
                    block: Light(color: (1.0, 0.6, 0.3), intensity: 50000.0, height: 0.2),
                    size: (bind: SplashReach, scale: 3.0), duration: 0.25, curve: "flash",
                ),
                (
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_flash", shape: Radial,
                        lift: 0.15, soft_depth: 0.4, sort_bias: 3.0,
                        breakup: (noise: "noise_tile", scale: 1.5, amount: 0.35, softness: 0.25)),
                    size: (bind: SplashReach, scale: 1.25), size_curve: "flash_grow",
                    duration: 0.1, curve: "flash",
                ),
                (
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_fire", soft_depth: 0.5,
                        rotation: Random, erosion: "erode_late", lift: 0.35,
                        breakup: (noise: "noise_tile", scale: 1.3, amount: 0.35, softness: 0.14, shade: 0.7)),
                    placement: Disc(count: 5, radius: (bind: SplashReach, scale: 0.4)),
                    size: (bind: SplashReach, scale: 0.58), size_jitter: 0.2, size_curve: "fireball_grow",
                    ramp_curve: "cool", duration: 0.6, curve: "punch",
                ),
                (
                    // The shock front in the air plane, at the reach within about 0.1 s.
                    block: Ring(texture: "fireball_flipbook", ramp: "blast_ring", orient: Ground,
                        thickness: 0.3, mapping: Front, height: 0.02, sort_bias: 3.0, erosion: "front_break",
                        breakup: (noise: "noise_tile", scale: 6.0, amount: 0.55, softness: 0.15)),
                    radius: (from: (bind: SplashReach, scale: 0.35), to: (bind: SplashReach, scale: 1.0),
                        curve: "front_fast"),
                    size_curve: "thin_out", duration: 0.32, curve: "front_fade", priority: Critical,
                ),
                (block: Particles(emitter: "flak_fragments"), size: (scale: 0.2)),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "flak_smoke", soft_depth: 0.4,
                        rotation: Random, erosion: "erode_rise", drift: (0.3, 0.25, 0.1), spread: 0.4, lift: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.4, softness: 0.2, shade: 0.55)),
                    placement: Disc(count: 4, radius: (bind: SplashReach, scale: 0.45)),
                    size: (bind: SplashReach, scale: 0.5), size_jitter: 0.25, size_curve: "smoke_grow",
                    start: 0.06, duration: 1.6, curve: "puff_fade",
                ),
            ],
        ),
        // Ultralisk analogue's cleave (`stag_behemoth`, WP7; scale-out round 2): a heavy blow
        // driven into the ground at the struck unit's near edge (zones 0.5 / 1.0 / 1.5). Frame 0
        // shows the blow: a short warm flash and glint with sparks at the struck point, a crack
        // and dark churned earth over the full-damage zone, dark soil clods thrown on arcs. A
        // noise-broken dust front, lighter at its leading edge and darker soil behind it, races
        // to the reach (Critical) and thins out over six frames; dust of irregular lobes,
        // drawn per hit, settles. Everything is gone within a second, so a fast attacker's blows
        // (every 0.6 s) never stack into a lasting mark. Minor: frequent.
        "cleave_impact": (
            class: Minor,
            event: Splash,
            layers: [
                (
                    block: Light(color: (1.0, 0.62, 0.32), intensity: 25000.0, height: 0.6),
                    size: (bind: SplashFull, scale: 4.0), duration: 0.14, curve: "flash",
                ),
                (
                    // The impact flash at the struck point: frames 0 and 1.
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_flash", shape: Radial,
                        lift: 0.35, soft_depth: 0.2, rotation: Random, sort_bias: 2.0,
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.45, softness: 0.25)),
                    size: (bind: SplashFull, scale: 1.1), size_curve: "flash_grow",
                    duration: 0.09, curve: "flash",
                ),
                (block: Particles(emitter: "blast_sparks"), size: (scale: 0.1)),
                (
                    // The dust front: a thin skirt of dust clumps at the leading edge, torn
                    // into clumps and gaps by the noise from the first frame (no outline, no
                    // tinted disc inside), each hit with its own noise phase; the clumps shrink
                    // and break apart from the inside out as it ends (no pop). Critical: the
                    // cleave's area, marked by the clumps' outer edge.
                    block: Ring(texture: "smoke_puff", ramp: "cleave_front", orient: Ground,
                        thickness: 0.3, mapping: Front, height: 0.03, erosion: "skirt_break",
                        edge_noise: 0.66,
                        breakup: (noise: "noise_tile", scale: 5.0, amount: 0.8, softness: 0.15)),
                    radius: (from: (bind: SplashFull, scale: 0.9), to: (bind: SplashReach, scale: 1.0),
                        curve: "front_fast"),
                    duration: 0.5, curve: "skirt_fade", priority: Critical,
                ),
                (
                    // The ground cracked under the blow.
                    block: Decal(texture: "ground_crack", ramp: "crack", erosion: "erode_tail", depth: 0.6,
                        width: 0.8,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.35, softness: 0.15)),
                    size: (bind: SplashFull, scale: 1.8), size_jitter: 0.2,
                    duration: 0.95, curve: "punch",
                ),
                (
                    // Dark churned earth over the full-damage zone.
                    block: Decal(texture: "scorch", ramp: "churn", erosion: "erode_rise", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.8, amount: 0.5, softness: 0.2)),
                    size: (bind: SplashFull, scale: 1.5), size_jitter: 0.2,
                    duration: 0.9, curve: "punch",
                ),
                (
                    // A dense burst of dark dust at the struck point.
                    block: Sprite(texture: "smoke_puff", ramp: "cleave_dust", soft_depth: 0.15,
                        rotation: Random, erosion: "erode_rise", lift: 0.5,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.25, shade: 0.45)),
                    size: (bind: SplashFull, scale: 1.5), size_jitter: 0.25, size_curve: "dust_grow",
                    duration: 0.7, curve: "puff_fade",
                ),
                (
                    // Dust thrown out over the area: puffs of their own size, place and
                    // rotation, barely pushed outward, so each hit has its own irregular
                    // silhouette and no radial star.
                    block: Sprite(texture: "smoke_puff", ramp: "cleave_dust", soft_depth: 0.15,
                        rotation: Random, erosion: "erode_rise", lift: 0.6, spread: 0.15,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.25, shade: 0.45)),
                    placement: Disc(count: 6, radius: (bind: SplashMid, scale: 0.85)),
                    size: (bind: SplashReach, scale: 0.36), size_jitter: 0.55, size_curve: "dust_grow",
                    start: 0.02, duration: 0.8, curve: "puff_fade",
                ),
                (
                    // The dust skirt kicked out behind the front: many small puffs across the
                    // area pushed outward, so the front's edge is a ragged cloud, not a line.
                    block: Sprite(texture: "smoke_puff", ramp: "cleave_dust", soft_depth: 0.12,
                        rotation: Random, erosion: "erode_rise", lift: 0.35, spread: 0.35,
                        breakup: (noise: "noise_tile", scale: 1.3, amount: 0.5, softness: 0.25, shade: 0.4)),
                    placement: Disc(count: 12, radius: (bind: SplashReach, scale: 0.75)),
                    size: (bind: SplashReach, scale: 0.2), size_jitter: 0.5, size_curve: "dust_grow",
                    start: 0.03, duration: 0.6, curve: "puff_fade",
                ),
                (block: Particles(emitter: "cleave_clods"), size: (bind: SplashFull, scale: 0.8)),
                (block: Particles(emitter: "spine_chips"), size: (bind: SplashFull, scale: 0.6), start: 0.01),
            ],
        ),
        // A burrowed unit moving underground (Amendment 2, R5): the ground heaving over it, a
        // short broken ripple of churned earth and a little dust, laid every 0.2 s while it
        // moves, so a viewer who sees the ground sees where it goes and not the unit. Named by
        // a mode's `moving` slot; no shipped burrowed mode can move yet.
        "burrow_trail": (
            class: Minor,
            event: Mode,
            repeat: Some(0.2),
            layers: [
                (
                    block: Decal(texture: "earth_scar", ramp: "churn", erosion: "edge_then_tail", depth: 0.6,
                        width: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.5, softness: 0.2)),
                    size: (bind: UnitRadius, scale: 0.75), size_jitter: 0.2,
                    duration: 2.2, curve: "linger",
                ),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.3, spread: 0.2,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    size: (bind: UnitRadius, scale: 0.35), size_jitter: 0.3, size_curve: "dust_grow",
                    duration: 0.6, curve: "puff_fade",
                ),
            ],
        ),
        // WP8, concealment and stance (plan §5.5, Amendment 2). These are held on a unit by
        // client::effects::stance: a mode switch's morph while its channel runs, a stance while
        // the unit stands in its mode, a cover while it is concealed. `Shell` layers shape the
        // unit's own bubble; `held` layers stay until the look is released and then erode out.
        // Ground looks are anchored under the unit, covers at its body's centre.
        //
        // A body digging in (Lurker-analogue burrow; defaults.concealment.burrow_enter): the
        // bubble sinks into the ground over the morph, its highlight and its shadow fading as it
        // goes, a soil band at the ground line; dark clods are thrown off its rim, warm dust
        // rises round it, and loose earth heaps up round the hole and hands over to the
        // burrowed mound. A unit with its own burrowed clip (WP13) sinks only a little, so the
        // clip shows; the ground carries "dug in" (review 1, B-1). The stats change at the
        // channel's end (33 ticks); the dig goes on to 1.8 s (45 ticks, Q0069 option 2, D-6).
        "burrow_dig": (
            class: Minor,
            event: Mode,
            span: Some(1.8),
            layers: [
                (
                    block: Shell(sink: 0.92, clip_sink: 0.12, tint: (0.055, 0.033, 0.017, 0.0), soil: 0.25,
                        rim: (0.40, 0.30, 0.20, 0.25), matte: 1.0, shadow: 1.0, progress: true),
                    duration: 1.0, curve: "dig_sink", priority: Critical,
                ),
                (block: Particles(emitter: "burrow_clods"), size: (bind: UnitRadius, scale: 1.0), start: 0.05),
                (block: Particles(emitter: "burrow_clods"), size: (bind: UnitRadius, scale: 0.95), start: 0.55),
                (block: Particles(emitter: "burrow_clods"), size: (bind: UnitRadius, scale: 0.9), start: 1.1),
                (
                    // Dust rising off the rim while the shell pushes into the soil.
                    block: Sprite(texture: "smoke_puff", ramp: "dig_dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.3, spread: 0.35,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    placement: Disc(count: 7, radius: (bind: UnitRadius, scale: 1.05)),
                    size: (bind: UnitRadius, scale: 0.5), size_jitter: 0.3, size_curve: "dust_grow",
                    start: 0.05, duration: 1.3, curve: "puff_fade",
                ),
                (
                    // A last, lower puff as the body settles into its hole.
                    block: Sprite(texture: "smoke_puff", ramp: "dig_dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.2, spread: 0.45,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    placement: Disc(count: 5, radius: (bind: UnitRadius, scale: 1.0)),
                    size: (bind: UnitRadius, scale: 0.42), size_jitter: 0.3, size_curve: "dust_grow",
                    start: 1.35, duration: 0.8, curve: "puff_fade",
                ),
                (
                    // Loose earth heaping up round the hole, handing over to the mound: round,
                    // noise-edged heaps (a disc outline, so no box edge shows; review 1, B-3)
                    // centred outside the body, so they show beyond its outline, and darkening
                    // the floor, its shadow included (review 2, B2-1).
                    block: Decal(texture: "smoke_puff", ramp: "mound", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.2, fill: 0.85),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.45, softness: 0.2, shade: 0.3)),
                    placement: Circle(count: 12, radius: (bind: UnitRadius, scale: 1.2), spread: 0.06),
                    size: (bind: UnitRadius, scale: 0.42), size_jitter: 0.15, size_curve: "dust_grow",
                    start: 0.2, duration: 2.0, curve: "soil_hand_over",
                ),
                (
                    // The hollow opening round the body as it goes down, handing over to the
                    // mound's: a dark lip just outside its outline.
                    block: Decal(texture: "smoke_puff", ramp: "hollow", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.15, fill: 0.9),
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.4, softness: 0.25)),
                    size: (bind: UnitRadius, scale: 1.4), start: 0.5, duration: 1.6, curve: "soil_hand_over",
                ),
            ],
        ),
        // Standing burrowed (defaults.concealment.burrowed): the body low in a dark hollow with
        // no highlight and no shadow, a soil band at the ground line, a rim of heaped earth and
        // clods round it. The hollow's lip and the heaps lie outside the body's outline (review
        // 2, B2-1: a unit with its own clip is nearly full size and covered round 2's heaps),
        // and they darken the floor. A unit with its own burrowed clip shows that clip almost whole; one
        // without is sunk to a low dome. Shown to its owner and to an enemy that detects it; an
        // enemy that does not sees nothing (D-5).
        "burrow_mound": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    block: Shell(sink: 0.92, clip_sink: 0.12, tint: (0.055, 0.033, 0.017, 0.0), soil: 0.25,
                        rim: (0.40, 0.30, 0.20, 0.25), matte: 1.0, shadow: 1.0),
                    duration: 0.01, held: true, priority: Critical,
                ),
                (
                    block: Decal(texture: "smoke_puff", ramp: "hollow", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.15, fill: 0.9),
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.4, softness: 0.25)),
                    size: (bind: UnitRadius, scale: 1.4), duration: 0.5, curve: "soil_in", held: true,
                ),
                (
                    block: Decal(texture: "smoke_puff", ramp: "mound", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.2, fill: 0.85),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.45, softness: 0.2, shade: 0.3)),
                    placement: Circle(count: 12, radius: (bind: UnitRadius, scale: 1.2), spread: 0.06),
                    size: (bind: UnitRadius, scale: 0.42), size_jitter: 0.15,
                    duration: 0.5, curve: "soil_in", held: true,
                ),
                (
                    // Clods lying on the heaped earth.
                    block: Sprite(texture: "debris_atlas", ramp: "clod", rotation: Random, lift: 0.5),
                    placement: Circle(count: 10, radius: (bind: UnitRadius, scale: 1.3), spread: 0.12),
                    size: (bind: UnitRadius, scale: 0.11), size_jitter: 0.4,
                    duration: 0.4, curve: "come_in", held: true,
                ),
            ],
        ),
        // A body breaking out of the ground (defaults.concealment.burrow_leave, 11 ticks): it
        // heaves up at once and rises out of its hole, its shadow and highlight coming back,
        // throwing clods and dust; the heaped earth stays behind for three seconds.
        "burrow_emerge": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    block: Shell(sink: 0.92, clip_sink: 0.12, tint: (0.055, 0.033, 0.017, 0.0), soil: 0.25,
                        rim: (0.40, 0.30, 0.20, 0.25), matte: 1.0, shadow: 1.0, progress: true),
                    duration: 1.0, curve: "emerge_sink", priority: Critical,
                ),
                (block: Particles(emitter: "burrow_clods"), size: (bind: UnitRadius, scale: 1.0)),
                (block: Particles(emitter: "burrow_clods"), size: (bind: UnitRadius, scale: 0.85), start: 0.2),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "dig_dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.35, spread: 0.5,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    placement: Disc(count: 7, radius: (bind: UnitRadius, scale: 1.0)),
                    size: (bind: UnitRadius, scale: 0.5), size_jitter: 0.3, size_curve: "dust_grow",
                    start: 0.02, duration: 1.0, curve: "puff_fade",
                ),
                (
                    block: Decal(texture: "smoke_puff", ramp: "mound", erosion: "erode_tail", depth: 0.6,
                        darken: true, outline: (edge_noise: 0.2, fill: 0.85),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.45, softness: 0.2, shade: 0.3)),
                    placement: Circle(count: 12, radius: (bind: UnitRadius, scale: 1.2), spread: 0.06),
                    size: (bind: UnitRadius, scale: 0.42), size_jitter: 0.15,
                    duration: 3.0, curve: "soil_linger",
                ),
                (
                    block: Decal(texture: "smoke_puff", ramp: "hollow", erosion: "erode_tail", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.15, fill: 0.9),
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.4, softness: 0.25)),
                    size: (bind: UnitRadius, scale: 1.4), duration: 2.5, curve: "soil_linger",
                ),
            ],
        ),
        // A cloaked unit its viewer owns (defaults.concealment.cloaked_own): a cool, translucent
        // glass shape whose picture stays readable (Q0076), a soft outline light, a faint bend
        // of what is behind it and a smaller shadow at its foot, so its owner reads "hidden" at
        // a glance and still sees where it is. The shadow shrinks to the foot and back with the
        // veil (review 1, B-2; review 2, S-1: it stays attached to the body).
        "cloak_own": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    block: Shell(veil: 0.45, tint: (0.30, 0.46, 0.62, 0.15), rim: (0.55, 0.78, 1.0, 0.55),
                        shadow: 0.6),
                    duration: 0.35, curve: "come_in", held: true, priority: Critical,
                ),
                (
                    block: Distortion(noise: "noise_tile", scale: 1.4, scroll: (0.05, 0.3), strength: 0.02, lens: 0.05),
                    size: (bind: UnitRadius, scale: 1.15), duration: 0.35, curve: "come_in", held: true,
                ),
            ],
        ),
        // A cloaked enemy the viewer does not detect (defaults.concealment.cloaked_enemy;
        // Q0076): only a faint refractive shimmer where it is, the scene behind its outline
        // bent as by a glass body, slowly crawling; no colour of its own, no bubble, no ring.
        "cloak_shimmer": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    block: Distortion(noise: "noise_tile", scale: 1.3, scroll: (0.04, 0.35), strength: 0.025, lens: 0.07),
                    size: (bind: UnitRadius, scale: 1.15), duration: 0.35, curve: "come_in", held: true,
                    priority: Critical,
                ),
            ],
        ),
        // A concealed enemy the viewer detects (defaults.concealment.detected): drawn as it
        // is, with a thin cold outline light and a slight bend at its edge, so the player sees
        // it is hidden from others and can be shot because a detector is near.
        "detected_mark": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    block: Shell(rim: (0.62, 0.80, 1.0, 0.42)),
                    duration: 0.3, curve: "come_in", held: true, priority: Critical,
                ),
                (
                    block: Distortion(noise: "noise_tile", scale: 1.3, scroll: (0.04, 0.3), strength: 0.012, lens: 0.035),
                    size: (bind: UnitRadius, scale: 1.12), duration: 0.3, curve: "come_in", held: true,
                ),
            ],
        ),
        // A mode switch that anchors its unit (Siege-Tank analogue's siege and unsiege;
        // defaults.mode.transition): the hull ploughs a furrow round itself as it locks or
        // unlocks, the furrow's arc closing with the switch's progress (Critical: the switch is
        // readable for its whole channel, R4). Review 1, B-5: a trench of dark turned soil whose
        // width and radius waver round the turn, with lighter thrown earth on its outer berm and
        // freshly turned earth lit at its soft head; dark clods and warm dust are thrown up as
        // the switch begins. Review 2, B2-2: the furrow darkens the floor it is ploughed into,
        // the unit's shadow included, and its head is a soft, lighter stretch of about 13
        // degrees.
        "mode_seal_sweep": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    block: Ring(texture: "scorch", ramp: "plough", orient: Ground, thickness: 0.24,
                        mapping: Polar, height: 0.02, arc: (bind: ChannelProgress, scale: 1.0), waver: 0.45,
                        darken: true,
                        breakup: (noise: "noise_tile", scale: 6.0, amount: 0.3, softness: 0.2, shade: 0.3)),
                    radius: (from: (bind: UnitRadius, scale: 1.85), to: (bind: UnitRadius, scale: 1.85)),
                    duration: 0.01, curve: "soil_in", held: true, exit: 0.6, priority: Critical,
                ),
                (block: Particles(emitter: "burrow_clods"), size: (bind: UnitRadius, scale: 1.5)),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "dig_dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.25, spread: 0.35,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    placement: Disc(count: 6, radius: (bind: UnitRadius, scale: 1.6)),
                    size: (bind: UnitRadius, scale: 0.45), size_jitter: 0.3, size_curve: "dust_grow",
                    start: 0.02, duration: 1.0, curve: "puff_fade",
                ),
            ],
        ),
        // Anchored (the Siege-Tank analogue in siege mode): the soil is pressed down under the
        // hull and, darker, in patches where its stabilisers stand round it (review 1, B-6), so
        // friend and enemy read the stance at a glance; the hull settling kicks up a short puff
        // of dust as it anchors. Everything darkens the floor, the hull's shadow included (review
        // 2, B2-3). Review 3, A3-1: no ring and no outline. Round 3's held furrow and disc-edged
        // pressed soil made a hard-edged round pad, an aura's or a range's language; the soil's
        // edge fades out over the outer half of the mark and the patches' over most of theirs
        // (`outline.soft`, applied after the soil's thickening intensity, so it stays soft), and
        // the stabilisers' darker patches round it break the round boundary. The cracks,
        // invisible at the default zoom, are gone. The switch's furrow erodes out as these come
        // in.
        "siege_anchor": (
            class: Minor,
            event: Mode,
            layers: [
                (
                    // The ground pressed down under and round the hull: a soft disc fading out
                    // from about 0.8 to 1.6 radii (no edge noise: a wavering edge under a soft
                    // fade reads as rays).
                    block: Decal(texture: "smoke_puff", ramp: "crushed", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.0, fill: 0.7, soft: 0.5),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.35, softness: 0.3)),
                    size: (bind: UnitRadius, scale: 1.6), duration: 0.6, curve: "soil_in", held: true,
                ),
                (
                    // Where the stabilisers press: irregular, darker compaction round the hull.
                    block: Decal(texture: "smoke_puff", ramp: "pressed", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.05, fill: 0.7, soft: 0.8),
                        breakup: (noise: "noise_tile", scale: 1.8, amount: 0.4, softness: 0.3, shade: 0.3)),
                    placement: Circle(count: 4, radius: (bind: UnitRadius, scale: 1.4), spread: 0.1),
                    size: (bind: UnitRadius, scale: 0.9), size_jitter: 0.15,
                    duration: 0.6, curve: "soil_in", held: true,
                ),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "dig_dust", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.2, spread: 0.5,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.45)),
                    placement: Disc(count: 4, radius: (bind: UnitRadius, scale: 1.3)),
                    size: (bind: UnitRadius, scale: 0.36), size_jitter: 0.3, size_curve: "dust_grow",
                    duration: 0.5, curve: "puff_fade",
                ),
            ],
        ),
        // WP9, statuses (plan §5.5). Held on a unit by client::effects::stance while the
        // simulation publishes the status (a barrier only while it has absorption left), at the
        // centre of its body; released, their held layers erode out. `emit` lays another
        // effect at the unit's foot at a beat of its own (it stays where it was laid while the
        // unit moves on); `hit` spawns one when the simulation publishes a hit on the status.
        //
        // Stimmed (Marine and Marauder analogues; defaults.status.Overclock): the body runs
        // hot. Its rim beats a deep red at 0.6 s and its picture is warmed; as the stim goes in
        // the rim flares once and a breath of red vapour leaves the body; while it lasts thin
        // warm vapour rises off its top every half second, left behind as it runs.
        "stim_surge": (
            class: Minor,
            event: Status,
            emit: Some((effect: "stim_fumes", every: 0.35)),
            layers: [
                (
                    block: Shell(tint: (0.95, 0.30, 0.18, 0.34), rim: (1.0, 0.26, 0.14, 0.62),
                        pulse: Some((period: 0.6, depth: 0.6))),
                    duration: 0.25, curve: "come_in", held: true, exit: 0.4, priority: Critical,
                ),
                (block: Shell(rim: (1.0, 0.55, 0.32, 0.95)), duration: 0.35, curve: "flash"),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "stim_vapour", soft_depth: 0.2,
                        rotation: Random, erosion: "erode_rise", drift: (0.0, 0.55, 0.0), spread: 0.3,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.5, softness: 0.25, shade: 0.4)),
                    placement: Circle(count: 4, radius: (bind: UnitRadius, scale: 0.75), spread: 0.25),
                    size: (bind: UnitRadius, scale: 0.42), size_jitter: 0.25, size_curve: "smoke_grow",
                    duration: 0.8, curve: "puff_fade",
                ),
            ],
        ),
        // Thin warm vapour off a stimmed body's top (laid by `stim_surge`; anchored at its foot,
        // lifted to its crown).
        "stim_fumes": (
            class: Ambient,
            event: Status,
            layers: [
                (
                    block: Sprite(texture: "smoke_puff", ramp: "stim_vapour", soft_depth: 0.2,
                        rotation: Random, erosion: "erode_rise", lift: 3.6, drift: (0.0, 0.6, 0.0),
                        breakup: (noise: "noise_tile", scale: 1.1, amount: 0.5, softness: 0.25, shade: 0.4)),
                    placement: Disc(count: 2, radius: (bind: UnitRadius, scale: 0.35)),
                    size: (bind: UnitRadius, scale: 0.6), size_jitter: 0.25, size_curve: "smoke_grow",
                    duration: 1.0, curve: "puff_fade",
                ),
            ],
        ),
        // Slowed (the Marauder analogue's concussive shells, or any slowing status;
        // defaults.status.Slowed): the body is dulled, its picture greyed and darkened and its
        // glass highlight dimmed; the blow lands as one pale flare of the rim. No drag dust:
        // the greyed body carries the slow (review 2, A2-1: dust that reads on this floor read
        // as a trail).
        "concussive_daze": (
            class: Minor,
            event: Status,
            layers: [
                (
                    // Review 1, A1-2: no rim (every bubble has a pale cold rim of its own); the
                    // picture greyed and darkened and the glass dulled instead.
                    block: Shell(tint: (0.30, 0.31, 0.33, 0.62), matte: 0.75),
                    duration: 0.2, curve: "come_in", held: true, exit: 0.3, priority: Critical,
                ),
                (block: Shell(rim: (0.85, 0.88, 1.0, 0.8)), duration: 0.3, curve: "flash"),
            ],
        ),
        // Charging (Zealot analogue's charge; defaults.status.Dash): the body lit from within
        // by a cold violet-white outline while it lunges, and the ground torn up behind it: its
        // feet kick up warm dust and leave dark scuffs every few steps, which stay a moment.
        // No streaks or lines: the trail is the disturbed ground.
        "charge_streak": (
            class: Minor,
            event: Status,
            emit: Some((effect: "charge_dust", every: 0.1, moving: true)),
            layers: [
                (
                    // Review 1, A1-3: a hot white outline, which a violet unit's own picture
                    // does not drown.
                    block: Shell(tint: (1.0, 0.95, 0.86, 0.14), rim: (1.0, 0.97, 0.90, 0.88)),
                    duration: 0.12, curve: "come_in", held: true, exit: 0.3, priority: Critical,
                ),
            ],
        ),
        // What a charging unit leaves on the ground (laid by `charge_streak` while it moves).
        "charge_dust": (
            class: Minor,
            event: Status,
            layers: [
                (
                    // Review 2, A2-2: whole from its first frame (no erosion while it holds),
                    // short enough that two lays a tenth of a second apart leave a gap.
                    block: Decal(texture: "earth_scar", ramp: "scuff", erosion: "erode_tail", depth: 0.6,
                        width: 0.45, darken: true,
                        breakup: (noise: "noise_tile", scale: 2.2, amount: 0.35, softness: 0.2)),
                    size: (bind: UnitRadius, scale: 0.75), size_jitter: 0.25,
                    duration: 1.6, curve: "scuff_hold",
                ),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "charge_kick", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_rise", lift: 0.5, spread: 0.35,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.4, softness: 0.2, shade: 0.4)),
                    placement: Disc(count: 2, radius: (bind: UnitRadius, scale: 0.35)),
                    size: (bind: UnitRadius, scale: 0.95), size_jitter: 0.3, size_curve: "dust_grow",
                    duration: 0.55, curve: "puff_fade",
                ),
            ],
        ),
        // A raised barrier (Immortal analogue's barrier; defaults.status.Barrier): a thin
        // energy membrane round the body, a little larger than its bubble, faint where it faces
        // the camera and pale gold along its edge, a fine crackle open in its face; it thins as
        // the barrier absorbs (`BarrierRatio`, never below 0.45 of itself while it stands) and
        // snaps up with one bright pass. Every hit it absorbs flares it (`barrier_absorb`).
        "barrier_shell": (
            class: Minor,
            event: Status,
            hit: Some((effect: "barrier_absorb", every: 0.16)),
            layers: [
                (
                    block: Sprite(texture: "smoke_puff", ramp: "barrier_membrane", shape: Membrane,
                        soft_depth: 0.25, sort_bias: 0.6, erosion: "membrane_form",
                        breakup: (noise: "noise_tile", scale: 2.2, amount: 0.45, softness: 0.35)),
                    size: (bind: UnitRadius, scale: 1.32), duration: 0.3, curve: "come_in", held: true,
                    exit: 0.3, priority: Critical, strength: Some((bind: BarrierRatio, floor: 0.75)),
                ),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "barrier_flash", shape: Membrane,
                        soft_depth: 0.25, sort_bias: 0.7, erosion: "membrane_crackle",
                        breakup: (noise: "noise_tile", scale: 2.2, amount: 0.5, softness: 0.3)),
                    size: (bind: UnitRadius, scale: 1.25), size_curve: "membrane_swell",
                    duration: 0.3, curve: "flash",
                ),
            ],
        ),
        // A barrier absorbing a hit (`barrier_shell`'s hit): the membrane flares pale and
        // crackles away again, with a short warm light on the body; every flare cracks along
        // its own noise.
        "barrier_absorb": (
            class: Minor,
            event: Status,
            layers: [
                (
                    block: Sprite(texture: "smoke_puff", ramp: "barrier_flash", shape: Membrane,
                        soft_depth: 0.25, sort_bias: 0.7, erosion: "membrane_crackle",
                        breakup: (noise: "noise_tile", scale: 2.4, amount: 0.55, softness: 0.3)),
                    size: (bind: UnitRadius, scale: 1.27), size_curve: "membrane_swell",
                    duration: 0.24, curve: "flash", priority: Critical,
                ),
                (
                    block: Light(color: (1.0, 0.78, 0.42), intensity: 6000.0, height: 0.2),
                    size: (bind: UnitRadius, scale: 3.0), duration: 0.18, curve: "flash",
                ),
            ],
        ),
        // WP9, deaths (named by a unit's presentation block, replacing the default glass
        // shatter; anchored on the ground where the unit stood, sized by its radius).
        //
        // A vehicle destroyed: its bubble's glass bursts outward in pale shards, a short hot
        // flash and a ball of fire from the hull, sparks and dark wreckage thrown out, black
        // smoke rising for two seconds and a charred scorch where it stood.
        "vehicle_wreck": (
            class: Major,
            event: Death,
            layers: [
                (
                    block: Light(color: (1.0, 0.55, 0.25), intensity: 40000.0, height: 0.8),
                    size: (bind: UnitRadius, scale: 5.0), duration: 0.28, curve: "flash",
                ),
                (
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_flash", shape: Radial,
                        lift: 1.0, soft_depth: 0.4, sort_bias: 2.0,
                        breakup: (noise: "noise_tile", scale: 1.5, amount: 0.3, softness: 0.25)),
                    size: (bind: UnitRadius, scale: 1.3), size_curve: "flash_grow",
                    duration: 0.1, curve: "flash",
                ),
                (
                    block: Sprite(texture: "fireball_flipbook", ramp: "blast_fire",
                        soft_depth: 0.5, rotation: Random, erosion: "erode_late", lift: 0.8,
                        breakup: (noise: "noise_tile", scale: 1.3, amount: 0.35, softness: 0.14, shade: 0.7)),
                    placement: Disc(count: 2, radius: (bind: UnitRadius, scale: 0.35)),
                    size: (bind: UnitRadius, scale: 1.0), size_jitter: 0.2, size_curve: "fireball_grow",
                    ramp_curve: "cool", start: 0.02, duration: 0.75, curve: "punch", priority: Critical,
                ),
                (block: Particles(emitter: "glass_shards"), size: (bind: UnitRadius, scale: 0.9)),
                (block: Particles(emitter: "blast_sparks"), size: (scale: 0.1)),
                (block: Particles(emitter: "wreck_chunks"), size: (bind: UnitRadius, scale: 0.5), start: 0.03),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "wreck_smoke", soft_depth: 0.6,
                        rotation: Random, erosion: "erode_rise", drift: (0.0, 0.6, 0.0), lift: 0.6,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.35, softness: 0.2, shade: 0.5)),
                    placement: Disc(count: 3, radius: (bind: UnitRadius, scale: 0.6)),
                    size: (bind: UnitRadius, scale: 0.85), size_curve: "smoke_grow", size_jitter: 0.25,
                    start: 0.16, duration: 2.2, curve: "puff_fade",
                ),
                (
                    block: Decal(texture: "scorch", ramp: "ember", erosion: "erode_rise", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.5, softness: 0.2)),
                    size: (bind: UnitRadius, scale: 1.1), start: 0.02, duration: 1.0, curve: "flash",
                ),
                // Burning coals of the hull glowing on in the wreck, cooling from yellow-white to
                // dull red and flickering as they die (review 2, A2-4: points of light, not
                // painted shapes).
                (block: Particles(emitter: "wreck_coals"), size: (bind: UnitRadius, scale: 0.7), start: 0.1),
                (
                    block: Decal(texture: "scorch", ramp: "char", erosion: "erode_tail", depth: 0.6,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.4, softness: 0.12)),
                    size: (bind: UnitRadius, scale: 1.35), size_jitter: 0.08,
                    start: 0.04, duration: 6.0, curve: "linger", priority: Critical,
                ),
            ],
        ),
        // A creature burst open: its bubble's glass breaks outward in pale shards, dark ichor
        // is thrown out on arcs and splashes round where it stood, a low foul vapour rises, and
        // a dark wet stain stays a few seconds.
        "bio_burst": (
            class: Major,
            event: Death,
            layers: [
                (
                    // A dark wet splash crown, thickened (intensity 2) so it is an opaque body of
                    // ichor and not a translucent disc (review 1, A1-5).
                    block: Sprite(texture: "acid_crown", ramp: "ichor", soft_depth: 0.3, rotation: Random,
                        erosion: "erode_late", lift: 0.55,
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.45, softness: 0.15, shade: 0.6)),
                    size: (bind: UnitRadius, scale: 0.9), size_curve: "burst_grow",
                    duration: 0.4, curve: "lip_thick", priority: Critical,
                ),
                (block: Particles(emitter: "glass_shards"), size: (bind: UnitRadius, scale: 0.9)),
                (block: Particles(emitter: "ichor_globs"), size: (bind: UnitRadius, scale: 0.5), start: 0.02),
                (block: Particles(emitter: "ichor_spray"), size: (bind: UnitRadius, scale: 0.4)),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "bio_vapour", soft_depth: 0.4,
                        rotation: Random, erosion: "erode_rise", drift: (0.0, 0.3, 0.0), lift: 0.4, spread: 0.3,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.45, softness: 0.2, shade: 0.5)),
                    placement: Disc(count: 3, radius: (bind: UnitRadius, scale: 0.6)),
                    size: (bind: UnitRadius, scale: 0.6), size_curve: "smoke_grow", size_jitter: 0.3,
                    start: 0.1, duration: 1.6, curve: "puff_fade",
                ),
                (
                    // The stain's body: a smaller core with three large lobes thrown out round it
                    // (review 2, A2-3: a low-frequency irregular silhouette, not a disc), each a
                    // soft-edged disc whose edge wavers only gently, so the union is a splash
                    // with no hair fringe.
                    block: Decal(texture: "acid_stain", ramp: "ichor_stain", erosion: "edge_then_tail", depth: 0.6,
                        darken: true, outline: (edge_noise: 0.06, fill: 0.75, soft: 0.45),
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.4, softness: 0.25)),
                    size: (bind: UnitRadius, scale: 0.72), size_jitter: 0.08, size_curve: "stain_spread",
                    start: 0.03, duration: 5.0, curve: "linger", priority: Critical,
                ),
                (
                    block: Decal(texture: "acid_stain", ramp: "ichor_stain", erosion: "edge_then_tail", depth: 0.6,
                        darken: true, width: 0.6, outline: (edge_noise: 0.06, fill: 0.75, soft: 0.5),
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.4, softness: 0.25)),
                    placement: Circle(count: 3, radius: (bind: UnitRadius, scale: 0.6), spread: 0.3),
                    size: (bind: UnitRadius, scale: 0.55), size_jitter: 0.35, size_curve: "stain_spread",
                    start: 0.05, duration: 4.8, curve: "linger",
                ),
                (
                    // Drops thrown further out: round ones of very different sizes...
                    block: Decal(texture: "acid_stain", ramp: "ichor_stain", erosion: "edge_then_tail", depth: 0.6,
                        darken: true, outline: (edge_noise: 0.05, fill: 0.75, soft: 0.4),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.4, softness: 0.25)),
                    placement: Circle(count: 4, radius: (bind: UnitRadius, scale: 1.5), spread: 0.45),
                    size: (bind: UnitRadius, scale: 0.13), size_jitter: 0.6,
                    start: 0.25, duration: 4.5, curve: "linger",
                ),
                (
                    // ...and elongated drips.
                    block: Decal(texture: "acid_stain", ramp: "ichor_stain", erosion: "edge_then_tail", depth: 0.6,
                        darken: true, width: 0.35, outline: (edge_noise: 0.05, fill: 0.75, soft: 0.4),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.4, softness: 0.25)),
                    placement: Circle(count: 3, radius: (bind: UnitRadius, scale: 1.1), spread: 0.35),
                    size: (bind: UnitRadius, scale: 0.26), size_jitter: 0.4,
                    start: 0.2, duration: 4.5, curve: "linger",
                ),
            ],
        ),
        // WP10, areas and tethers (plan §5.5, D-8), named by their casters' `abilities`. Each
        // is held while the simulation publishes its area or tether and erodes out over its
        // exit when it ends; an area is drawn only where its viewer sees it. No light: a point
        // light is not cut where the fog begins. Round 2 (WP10 review 1): the colours are the
        // briefs' display colours in linear values (A1-4); the bodies lie low over the disc so
        // units inside stay readable and nothing spills past the far edge.
        //
        // Psionic Storm (High Templar analogue): a dark, saturated indigo cloud lying over the
        // area and hiding most of the floor (flat sheets just above the ground, and a few
        // billows standing in it), lit from within by small pockets of discharge that flare
        // and fade (`storm_flare`, every 0.16 s) and stay below display white; the floor under
        // it tinted darker violet; a dark violet band whose outer lip is the area's true edge
        // (`Critical`). No lightning strokes or rays.
        "psionic_storm": (
            class: Major,
            event: Area,
            emit: Some((effect: "storm_flare", every: 0.16)),
            layers: [
                (
                    // The area's edge: a band inside the radius, darkest and densest at its outer
                    // lip on it.
                    block: Ring(texture: "smoke_puff", ramp: "storm_rim", orient: Ground,
                        thickness: 0.28, mapping: Front, height: 0.03, edge_noise: 0.05,
                        breakup: (noise: "noise_tile", scale: 4.0, amount: 0.3, softness: 0.25)),
                    radius: (from: (bind: AreaRadius, scale: 1.0), to: (bind: AreaRadius, scale: 1.0)),
                    duration: 0.12, curve: "hold_dense", held: true, exit: 0.2, priority: Critical,
                ),
                (
                    // The floor under the storm, tinted darker violet, ending on the edge.
                    block: Decal(texture: "smoke_puff", ramp: "storm_floor", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.005, fill: 0.5),
                        breakup: (noise: "noise_tile", scale: 1.6, amount: 0.2, softness: 0.3)),
                    size: (bind: AreaRadius, scale: 1.01), duration: 0.15, curve: "come_in",
                    held: true, exit: 0.2, priority: Critical,
                ),
                (
                    // The body of the cloud: flat sheets just above the ground, overlapping so
                    // that they hide most of the floor, kept inside the disc.
                    block: Sprite(texture: "smoke_puff", ramp: "storm_cloud", orient: Ground,
                        soft_depth: 0.05, rotation: Random, lift: 0.12,
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.4, softness: 0.3, shade: 0.5)),
                    placements: [
                        Disc(count: 8, radius: (bind: AreaRadius, scale: 0.45)),
                        Circle(count: 15, radius: (bind: AreaRadius, scale: 0.8), spread: 0.02),
                    ],
                    size: (bind: AreaRadius, scale: 0.24), size_jitter: 0.05,
                    duration: 0.2, curve: "come_in", held: true, exit: 0.35,
                ),
                (
                    // A few billows standing in it, low, so the storm has body.
                    block: Sprite(texture: "smoke_puff", ramp: "storm_cloud", soft_depth: 0.4,
                        rotation: Random, lift: 0.35,
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.5, softness: 0.3, shade: 0.5)),
                    placement: Disc(count: 4, radius: (bind: AreaRadius, scale: 0.45)),
                    size: (bind: AreaRadius, scale: 0.3), size_jitter: 0.2,
                    duration: 0.2, curve: "come_in", held: true, exit: 0.35,
                ),
            ],
        ),
        // A pocket of a storm's discharge, laid by `psionic_storm` at a random place in it: a
        // billow of the cloud swelling and thinning, and a small flare of violet light in it.
        "storm_flare": (
            class: Minor,
            event: Area,
            layers: [
                (
                    block: Sprite(texture: "smoke_puff", ramp: "storm_cloud", soft_depth: 0.4,
                        rotation: Random, lift: 0.4, erosion: "erode_late",
                        breakup: (noise: "noise_tile", scale: 1.5, amount: 0.5, softness: 0.3, shade: 0.5)),
                    placement: Disc(count: 1, radius: (bind: AreaRadius, scale: 0.55)),
                    size: (bind: AreaRadius, scale: 0.3), size_jitter: 0.25, size_curve: "billow_grow",
                    duration: 0.8, curve: "billow",
                ),
                (
                    block: Sprite(texture: "smoke_puff", ramp: "storm_flare", soft_depth: 0.4,
                        rotation: Random, lift: 0.5,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.55, softness: 0.25)),
                    placement: Disc(count: 1, radius: (bind: AreaRadius, scale: 0.55)),
                    size: (bind: AreaRadius, scale: 0.16), size_jitter: 0.3,
                    duration: 0.28, curve: "flare",
                ),
            ],
        ),
        // Blinding Cloud (Viper analogue): a dense, low murk covering the whole disc evenly
        // (flat sheets just above the ground in a disc and a ring), rolling as billows swell and
        // thin in it (`murk_billow`, every 0.2 s), over ground darkened to about half its
        // brightness, out to a darker front whose outer lip is the area's true edge
        // (`Critical`). Units inside stand out of the low sheets.
        "blinding_cloud": (
            class: Major,
            event: Area,
            emit: Some((effect: "murk_billow", every: 0.2)),
            layers: [
                (
                    // The area's edge: the murk's front darkening the ground, darkest at its
                    // outer lip on the radius.
                    block: Ring(texture: "smoke_puff", ramp: "murk_edge", orient: Ground,
                        thickness: 0.22, mapping: Front, height: 0.03, darken: true, edge_noise: 0.05,
                        breakup: (noise: "noise_tile", scale: 4.0, amount: 0.3, softness: 0.25)),
                    radius: (from: (bind: AreaRadius, scale: 1.0), to: (bind: AreaRadius, scale: 1.0)),
                    duration: 0.3, curve: "hold_dense", held: true, exit: 0.25, priority: Critical,
                ),
                (
                    block: Decal(texture: "smoke_puff", ramp: "murk_shade", depth: 0.6, darken: true,
                        outline: (edge_noise: 0.005, fill: 0.5),
                        breakup: (noise: "noise_tile", scale: 1.4, amount: 0.2, softness: 0.3)),
                    size: (bind: AreaRadius, scale: 1.01), duration: 0.3, curve: "come_in",
                    held: true, exit: 0.25, priority: Critical,
                ),
                (
                    // The pall: flat sheets just above the ground, evenly over the disc.
                    block: Sprite(texture: "smoke_puff", ramp: "murk", orient: Ground,
                        soft_depth: 0.05, rotation: Random, lift: 0.1,
                        breakup: (noise: "noise_tile", scale: 1.2, amount: 0.35, softness: 0.3, shade: 0.5)),
                    placements: [
                        Disc(count: 8, radius: (bind: AreaRadius, scale: 0.45)),
                        Circle(count: 15, radius: (bind: AreaRadius, scale: 0.8), spread: 0.02),
                    ],
                    size: (bind: AreaRadius, scale: 0.24), size_jitter: 0.05,
                    duration: 0.35, curve: "come_in", held: true, exit: 0.45,
                ),
            ],
        ),
        // A billow rolling in a blinding cloud, low over the pall.
        "murk_billow": (
            class: Minor,
            event: Area,
            layers: [
                (
                    block: Sprite(texture: "smoke_puff", ramp: "murk", soft_depth: 0.4,
                        rotation: Random, lift: 0.25, erosion: "erode_late", drift: (0.0, 0.06, 0.0),
                        breakup: (noise: "noise_tile", scale: 1.3, amount: 0.5, softness: 0.3, shade: 0.5)),
                    placement: Disc(count: 1, radius: (bind: AreaRadius, scale: 0.55)),
                    size: (bind: AreaRadius, scale: 0.28), size_jitter: 0.25, size_curve: "billow_grow",
                    duration: 1.4, curve: "billow",
                ),
            ],
        ),
        // Abduct (Viper analogue): the tongue from the caster's body to its victim's, an opaque
        // dark red-brown muscle with darker edges (no light core, no glow, never a beam): a
        // narrow core, and over it two strips of bulges, widening it by more than half where
        // they swell, that travel back towards the caster at clearly different speeds (round 4,
        // WP10 review 3, A3-1 (c)); a blunt, round grip pressed against the victim, set back from
        // its surface by 0.6 of its own radius at any range (A3-1 (a), (b)), and a smaller
        // swelling where it leaves the caster. Its ends follow the two bubbles; it does not
        // narrow into the victim.
        "abduct_tether": (
            class: Minor,
            event: Link,
            layers: [
                (
                    // The core: a soft rod held at 2.5 times its coverage, so it is opaque out to
                    // its dark edges (A2-2 (b)); no taper at the victim.
                    block: Ribbon(texture: "droplet", ramp: "tongue", shape: Radial, taper: (0.04, 0.0),
                        soft_depth: 0.1,
                        breakup: (noise: "noise_tile", scale: 2.0, amount: 0.2, softness: 0.3, shade: 0.6)),
                    size: (scale: 0.09), duration: 0.1, curve: "hold_dense", held: true, exit: 0.15,
                    priority: Critical,
                ),
                (
                    // The fast bulges: a strip of the puff texture repeating every 0.8 units,
                    // about 1.3 units a second towards the caster (a spacing long enough that two
                    // shots up to 0.3 s apart still show which way it went).
                    block: Ribbon(texture: "smoke_puff", ramp: "tongue", taper: (0.04, 0.0),
                        repeat: 0.8, scroll: -1.6, soft_depth: 0.1,
                        breakup: (noise: "noise_tile", scale: 2.5, amount: 0.15, softness: 0.3, shade: 0.6)),
                    size: (scale: 0.24), duration: 0.1, curve: "hold_dense", held: true, exit: 0.15,
                ),
                (
                    // The slow bulges: every 0.53 units, about 0.48 units a second, so the fast
                    // ones overtake them and the sum never repeats evenly.
                    block: Ribbon(texture: "smoke_puff", ramp: "tongue", taper: (0.04, 0.0),
                        repeat: 0.53, scroll: -0.9, soft_depth: 0.1,
                        breakup: (noise: "noise_tile", scale: 1.9, amount: 0.15, softness: 0.3, shade: 0.6)),
                    size: (scale: 0.2), duration: 0.1, curve: "hold_dense", held: true, exit: 0.15,
                ),
                (
                    // The grip: a blunt, round swelling, set back from the victim's surface by
                    // 0.6 of its radius, fixed in rotation and without noise, so its outline is
                    // a soft round end on every driver.
                    block: Sprite(texture: "droplet", ramp: "tongue", shape: Radial, soft_depth: 0.1),
                    placement: LineEnd(back: (scale: 0.2)),
                    size: (scale: 0.34), duration: 0.1, curve: "hold_firm", held: true, exit: 0.15,
                ),
                (
                    // The swelling where the tongue leaves the caster.
                    block: Sprite(texture: "droplet", ramp: "tongue", shape: Radial, soft_depth: 0.1),
                    size: (scale: 0.17), duration: 0.1, curve: "hold_firm", held: true, exit: 0.15,
                ),
            ],
        ),
    },
    // Pool capacities (sized at load, never grown in a battle) and level of detail (§5.6).
    // Sized in WP6c to the measured peak of the stress run (`frame_budget --effect-stress 200`:
    // 200 splashes per second round-robin over the slice's effects, about 1 100 live effects
    // with the 8 s scorch and 6 s stain): no effect refused and no Critical instance without a
    // slot. The class caps stay low, so in such a crowd the Detail layers of the oldest Major
    // effects retire (eroded out) and the Critical layers carry the picture. Round 2 adds the
    // acid flecks (Minor, 16 per burst, 4.5 s) to the effect pool. Scale-out round 3: the
    // flame and lance bands are several decals each, and the round-2 stress frame with all
    // seven effects drew 3 921 decals, 96 % of the old 4 096; the pool is now 6 144, about a
    // third of headroom at that load. Round 4 (Amendment 7): each effect reserves its decals at
    // birth, whole or not at all, and above 85 % of the pool the oldest lasting marks erode out
    // to make room (docs/evidence/effects/review/stress_capture.txt). The class caps count an
    // effect only while its fire (non-decal layers) is alive.
    budget: (
        particles: 30000,
        sprites: 4096,
        decals: 6144,
        lights: 16,
        effects: 2048,
        classes: { Major: 96, Minor: 512, Ambient: 128 },
        min_screen_px: 6.0,
        full_particle_px: 96.0,
        crowd_threshold: 24,
    ),
    // Effects used where a unit's presentation block names none. Weapons and deaths: none yet
    // (WP11). Concealment and modes (WP8): every burrowed mode digs, stands and breaks out
    // with these, every cloaked unit wears its viewer's cover, and every other mode that
    // anchors its unit seals with `mode_seal_sweep`; a unit's block may name its own.
    defaults: (
        // WP9: every unit that receives one of these statuses shows it so, unless its block
        // names its own look. Deaths have no default: the legacy glass shatter stays the
        // default death, and a unit's block may name an effect that replaces it.
        status: {
            Overclock: "stim_surge",
            Slowed: "concussive_daze",
            Dash: "charge_streak",
            Barrier: "barrier_shell",
        },
        concealment: (
            burrow_enter: "burrow_dig",
            burrow_leave: "burrow_emerge",
            burrowed: "burrow_mound",
            cloaked_own: "cloak_own",
            cloaked_enemy: "cloak_shimmer",
            detected: "detected_mark",
        ),
        mode: (transition: "mode_seal_sweep"),
    ),
)
