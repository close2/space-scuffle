        // the soil tints the floor warm brown and is darker still in a unit's shadow, never
        // lighter. Soil heaped up around a burrowed body: a warm mid-brown, darker in the
        // hollows between its clumps and lighter on their tops.
        "mound": [
            (0.00, (0.30, 0.21, 0.13, 0.00)),
            (0.25, (0.30, 0.21, 0.13, 0.85)),
            (0.60, (0.42, 0.30, 0.19, 0.88)),
            (1.00, (0.58, 0.43, 0.28, 0.85)),
        ],
        // The hollow a burrowed body sits in: dark, damp, compacted soil, its lip showing just
