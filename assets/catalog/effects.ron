        // Intensity: a flash that starts at its peak.
        "flash": [(0.00, 1.00, EaseOutQuad), (1.00, 0.00, Linear)],
        // Intensity: on at once, held, fading only at the very end (erosion carries the exit).
        "hold": [(0.00, 1.00, Linear), (0.85, 1.00, EaseInQuad), (1.00, 0.00, Linear)],
        // Intensity of a wet lip (review round 5): thickened above 1, so the inner side of the
