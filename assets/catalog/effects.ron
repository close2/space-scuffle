        "cleave_dust": [
            (0.00, (0.015, 0.012, 0.008, 0.65)),
            (0.50, (0.075, 0.060, 0.043, 0.80)),
            (1.00, (0.30, 0.26, 0.20, 0.84)),
        ],
        // A band of scorched ground (alpha): near-black torn soil, a little lighter on its
