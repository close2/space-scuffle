    // Longest composed prompt accepted, in characters. The model's own limit is not published
    // for veo-3.1-*-001 (docs/evidence/veo/2026-11-04-api-notes.md); this keeps prompts short.
    max_prompt_chars: 1024,

    // Names of real games, studios, shows and franchises a prompt must not contain. Matched as
    // whole words or phrases, ignoring case.
    deny_list: [
        "StarCraft",
        "Blizzard",
        "Arcane",
        "Riot Games",
        "League of Legends",
        "Warcraft",
        "Warhammer",
        "Zerg",
        "Protoss",
        "Terran",
        "Star Wars",
        "Marvel",
        "Disney",
        "Pixar",
        "Gundam",
        "Transformers",
        "Nintendo",
    ],

    // Text that marks an unfinished prompt. A marker made of letters matches as a whole word
    // ignoring case; any other marker matches anywhere.
    placeholder_markers: ["TODO", "TBD", "FIXME", "XXX", "lorem", "ipsum", "placeholder", "{", "}"],

    // How `asset_baker` fits a clip (Veo returns 16:9) into the square game frame, chosen by
    // the identity's render shape (docs/plans/2026-11-04-veo-letterbox-bake.md, D-1 to D-3).
    // - CenterCrop: cut the centred square; a wide subject loses its sides.
    // - Letterbox(feather_permille: N): keep the whole frame, scaled to fit, with opaque bars in
    //   the colour measured from the clip's own border; the content's outermost N/1000 of the
    //   frame side blends into the bars (0 leaves a hard edge).
    framing: (
        // Units are taller than wide and centred, so the crop keeps them whole and large.
        unit_sphere: CenterCrop,
        // Structures are wide and Veo fills the 16:9 width with them; a crop cuts their base.
        building_dome: Letterbox(feather_permille: 30),
        // Exact catalog slug -> framing, for one identity whose clip needs the other treatment
        // (for example a wide flying unit). A slug that is not in the catalog is refused.
        //
        // repair_shuttle (batch 1, 2026-11-04): a wide twin-engine aircraft seen at 3/4; its
        // first clip (62f8d6c9) spans about 60 % of the 16:9 width, so the centre crop cut
        // off an engine pod. Letterboxed like a structure, it stays whole.
        //
        // welder_drone (batch 2, 2026-11-05): a wide worker seen at 3/4 with its welding torch
        // held out to one side; its first clip (d020071b) spans about 68 % of the 16:9 width,
        // so the centre crop cut off the torch. Letterboxed like the shuttle, it stays whole.
        //
        // railgun_crawler, shock_golem, jet_jumper, specter_android (batch 3, 2026-11-05): seen
        // at 3/4 with their weapons held out to the side (the tank's long barrels, the golem's
        // arm cannons, the hound's two pistols, the android's long rifle), each spans about 60
        // to 65 % of the 16:9 width and sits left of centre in its first clips (97931437,
        // c6ddca3c), so the centre crop cut off a weapon. Letterboxed, they stay whole.
        //
        // napalm_wheeler, colossus_mech, vector_interceptor, sky_bastion, cloak_gunship,
        // omni_probe_drone (batch 5, 2026-11-06): a trike, a wide mech with arm-cannons and four
        // aircraft seen at 3/4, the shapes the shuttle, the welder and batch 3 needed the
        // letterbox for; they are letterboxed from their first clip.
        //
        // burrow_scorpion (batch 6, 2026-11-09): a broad, flat creature seen at 3/4 with its claws
        // and tail spread wide, the shape the trike and the mech needed the letterbox for; it is
        // letterboxed from its first clip.
        //
        // mothership_carrier, saucer_interceptor (carrier batch, 2026-11-26): two wide flat
        // saucers seen at 3/4, the aircraft shape batch 5 letterboxed; letterboxed from the first
        // clip.
        //
        // spore_matriarch, brood_mite (broodlings batch, 2026-11-26): a wide winged beast and a
        // small creature with its claws spread, seen at 3/4; letterboxed from the first clip.
        overrides: {
            "spore_matriarch": Letterbox(feather_permille: 30),
            "brood_mite": Letterbox(feather_permille: 30),
            "mothership_carrier": Letterbox(feather_permille: 30),
            "saucer_interceptor": Letterbox(feather_permille: 30),
            "burrow_scorpion": Letterbox(feather_permille: 30),
            "repair_shuttle": Letterbox(feather_permille: 30),
            "welder_drone": Letterbox(feather_permille: 30),
            "railgun_crawler": Letterbox(feather_permille: 30),
            "shock_golem": Letterbox(feather_permille: 30),
            "jet_jumper": Letterbox(feather_permille: 30),
            "specter_android": Letterbox(feather_permille: 30),
            "napalm_wheeler": Letterbox(feather_permille: 30),
            "colossus_mech": Letterbox(feather_permille: 30),
            "vector_interceptor": Letterbox(feather_permille: 30),
            "sky_bastion": Letterbox(feather_permille: 30),
            "cloak_gunship": Letterbox(feather_permille: 30),
            "omni_probe_drone": Letterbox(feather_permille: 30),
        //
        // Batch 2 (docs/media/veo-video-requests-batch-2.md): the 24 Enclave and Swarm units seen
        // at 3/4 with legs, wings, scythes or weapons held out, letterboxed from the first clip as
        // every unit since batch 5.
            "flying_saucer": Letterbox(feather_permille: 30),
            "grav_harvester": Letterbox(feather_permille: 30),
            "warp_strider": Letterbox(feather_permille: 30),
            "prism_weaver": Letterbox(feather_permille: 30),
            "astral_vagrant": Letterbox(feather_permille: 30),
            "cerebral_elder": Letterbox(feather_permille: 30),
            "shadow_visitor": Letterbox(feather_permille: 30),
            "void_goliath": Letterbox(feather_permille: 30),
            "tripod_annihilator": Letterbox(feather_permille: 30),
            "stealth_eye_orb": Letterbox(feather_permille: 30),
            "phase_prism_saucer": Letterbox(feather_permille: 30),
            "prismatic_saucer": Letterbox(feather_permille: 30),
            "nectar_worker": Letterbox(feather_permille: 30),
            "razor_mantis": Letterbox(feather_permille: 30),
            "volatile_tick": Letterbox(feather_permille: 30),
            "mortar_stag": Letterbox(feather_permille: 30),
            "thorn_viper": Letterbox(feather_permille: 30),
            "stag_behemoth": Letterbox(feather_permille: 30),
            "hive_matron": Letterbox(feather_permille: 30),
            "mycelium_shaman": Letterbox(feather_permille: 30),
            "sonic_bat": Letterbox(feather_permille: 30),
            "sky_leviathan": Letterbox(feather_permille: 30),
            "tongue_chameleon": Letterbox(feather_permille: 30),
            "amber_pollen_dome": Letterbox(feather_permille: 30),
        },
    ),

    // How each state is made seamless (docs/plans/2026-11-04-veo-seamless-loops.md, D-1).
    // Every state the atlas loops (Idle, Walk, Cast) needs an entry; a state the atlas does not
    // loop may only set `pin_end`.
    // - pin_end: the start request sends the state's start picture also as `lastFrame`, so the
    //   clip must end on the picture it starts from. Vertex AI only; the picture must be PNG or
    //   JPEG, 16:9 within 1 %, at least 1280x720 and at most 20 MB.
    // - seam: repair done by the baker on the kept frames, in this order: scale lock (undo a
    //   steady camera zoom), then a cross-fade of the last N frames back into frame 0. N is at
    //   most 4 and at most a quarter of the frames the atlas keeps per state.
    loops: (
        states: {
            Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 2))),
            Walk: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 2))),
            Cast: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 2))),
            // Held on its last frame, not looped: pinned so that it ends on the picture Idle
            // starts from, and the switch to Idle on completion is seamless (D-3).
            Constructing: (pin_end: true, seam: None),
        },
        // Exact catalog slug -> state -> treatment, for one identity whose clip needs another
        // one. A slug that is not in the catalog is refused (as `framing.overrides`).
        //
        // repair_shuttle Idle (batch 1, 2026-11-04): its hover bob already loops (raw wrap as
        // high as the median step), and a cross-fade blends two bob positions into a double
        // image at the restart, so this clip keeps the scale lock and no cross-fade.
        // repair_shuttle Walk: pinned at both ends, its raw frames already loop; the hover bob
        // moves the hull up and down, which the scale lock reads as an uneven zoom and refuses.
        // There is no camera zoom to undo, so Walk keeps loop sampling only.
        // welder_drone Idle (batch 2, 2026-11-05): the same hover bob as the shuttle's. Its first
        // clip (d020071b) loops raw (wrap 0.907 above the median step 0.730 of its 8 kept
        // frames), and the default cross-fade of 2 of those 8 frames blends two bob positions
        // and fails (worst 0.723 < 0.805), so it keeps the scale lock and no cross-fade.
        // welder_drone Walk: pinned at both ends to the Idle frame 0; the default cross-fade of 2
        // of 8 frames shows a double image of the whole robot at the restart (the bob moves the
        // body by a few per cent of the frame), so it keeps loop sampling only, as the shuttle.
        //
        // railgun_crawler, shock_golem, jet_jumper, specter_android Attack (batch 3, 2026-11-05):
        // a one-shot that the game follows with Idle. Unpinned, the first Attack clips of the
        // golem (deab733a) and the hound (dfae7358) fired well and then lowered their weapons,
        // ending in a pose the Idle does not start from, so the switch back would snap. Their
        // Attack is pinned at its end to the Idle picture, as Constructing is (D-3), and is
        // still not looped.
        // specter_android Walk: pinned at both ends, its raw frames already loop (74014f87: raw
        // worst 0.800 against a threshold of 0.782); the default cross-fade of 2 of 10 frames
        // shows a double image of the legs at the restart, as on the welder, so it keeps loop
        // sampling only. jet_jumper Walk likewise: its raw frames loop (503ded63: raw worst 0.737
        // against 0.724, growth 1.45 %), and the scale lock reads the hopping stride as an
        // uneven zoom and refuses it although the camera does not move.
        // railgun_crawler Idle: pinned at both ends, its raw frames already loop (6eedaf3a: raw
        // wrap 0.940 above the median step 0.936, worst 0.909 against 0.906); a cross-fade of
        // the drifting smoke raises the median step and fails it by 0.0003, so it keeps the
        // scale lock and no cross-fade, as the shuttle and the welder. The redesigned crawler's
        // Idle (batch 4, 8d430dda) loops raw as well (wrap 0.926, worst 0.921 against 0.904).
        // shock_golem Walk (batch 4): pinned at both ends to the wide-stance Idle picture, eight
        // Walks barely stepped, stepped unevenly or leaned toward the camera; the end is left
        // free so the march can run through the clip, and loop sampling picks the loop with
        // a short cross-fade. The scale lock is off because a stride reads as an uneven zoom.
        // napalm_wheeler, colossus_mech, vector_interceptor, sky_bastion, cloak_gunship Attack
        // (batch 5, 2026-11-06): pinned at its end to the Idle picture, as batch 3's units.
        // colossus_mech Walk: the golem's treatment from the first attempt (the end left free,
        // loop sampling only), because a heavy wide-stance biped pinned at both ends barely
        // stepped in eight golem Walks.
        // napalm_wheeler Idle and Walk, colossus_mech Idle (batch 5): pinned at both ends, every
        // clip drifted away from the pin and came back (six trike Idles and its first Walk at
        // kept frames 6->7, five mech Idles), and a near-still subject makes that return the
        // worst step. The end is left free, as the golem's Walk, and loop sampling picks the
        // loop; the start is still the Idle pin.
        // colossus_mech Idle (batch 5b, 2026-11-09): back to the default, both ends pinned. The
        // re-seeded mech's pin comes from a seed whose camera pushed in, and with the end free
        // both Idles on it kept pushing in (+6.2 %, +12.2 %); the lowered arms no longer shift.
        // colossus_mech Walk (batch 5b): pinned at both ends for the same reason (two end-free
        // Walks on the new pin grew by +2.9 % and +8.0 %); it keeps loop sampling only, as the
        // specter's and the hound's Walks, because a stride reads as an uneven zoom.
        // napalm_wheeler Idle and Walk (batch 5b): the re-seeded trike has no outline glow to
        // shimmer, and with the end free its first Idle and Walk on the new pin drifted in
        // scale (-1.5 %, +2.5 %), so both are pinned at both ends again; Idle takes the
        // default treatment, and Walk keeps no scale lock (the spinning wheels and the hull's
        // vibration read as an uneven zoom) with the default cross-fade.
        // burrow_scorpion (batch 6, 2026-11-09): Attack pinned at its end to the Idle picture, as
        // batch 3's units. Walk keeps no scale lock from the first attempt, because a stride
        // reads as an uneven zoom (the specter, the hound, the mech). Its accepted Walk
        // (b1ef0cb7) loops raw (worst 0.696 against a threshold of 0.689), and a cross-fade of 2
        // of its 10 frames raises the median step and fails it by 0.0007, so it keeps loop
        // sampling only, as the crawler's Idle.
        // mothership_carrier, saucer_interceptor Attack (carrier batch, 2026-11-26): pinned at its
        // end to the Idle picture, as batch 5's aircraft.
        // spore_matriarch, brood_mite (broodlings batch, 2026-11-26): Attack pinned at its end to
        // the Idle picture; the Broodling's Walk keeps no scale lock and no cross-fade from the
        // first attempt, as the scorpion's (a stride reads as an uneven zoom). The Brood Lord
        // analogue's Idle and Walk keep no scale lock either: every clip of it beats its wings,
        // which reads as an uneven zoom; its accepted loops are a temporary exception under the
        // owner's answer to Q0133 (a polish pass redoes them).
        // saucer_interceptor Walk (carrier batch continuation, 2026-11-26): no scale lock. Its
        // light trails appear after the pinned first frame and vanish before the pinned last one,
        // which reads as an uneven zoom, so the default lock refuses the seam repair; the
        // accepted Walk is a temporary exception under the owner's answer to Q0131.
        overrides: {
            "spore_matriarch": {
                Attack: (pin_end: true, seam: None),
                Idle: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
            },
            "brood_mite": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "mothership_carrier": {
                Attack: (pin_end: true, seam: None),
            },
            "saucer_interceptor": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
            },
            "burrow_scorpion": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "napalm_wheeler": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
            },
            "colossus_mech": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "vector_interceptor": {
                Attack: (pin_end: true, seam: None),
            },
            "sky_bastion": {
                Attack: (pin_end: true, seam: None),
            },
            "cloak_gunship": {
                Attack: (pin_end: true, seam: None),
            },
            "railgun_crawler": {
                Attack: (pin_end: true, seam: None),
                Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
            },
            "shock_golem": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: false, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "jet_jumper": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "specter_android": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "welder_drone": {
                Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "repair_shuttle": {
                Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
        // Batch 2 (docs/media/veo-video-requests-batch-2.md): every Attack pinned at its end to the
        // Idle picture; every stride (walkers, Greys, creatures) keeps no scale lock and no
        // cross-fade, as the scorpion, the Broodling and the specter; every flight in place
        // (aircraft, drones, winged creatures, the gliding elder) keeps no scale lock with the
        // default cross-fade, as the interceptor, because its trails or wing motion read as an
        // uneven zoom.
            "flying_saucer": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Attack: (pin_end: true, seam: None),
            },
            "grav_harvester": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Attack: (pin_end: true, seam: None),
            },
            "warp_strider": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "prism_weaver": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Attack: (pin_end: true, seam: None),
            },
            "astral_vagrant": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "cerebral_elder": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Attack: (pin_end: true, seam: None),
            },
