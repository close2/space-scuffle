// assets/catalog/media_style.ron
// House style and prompt rules for generated unit and structure media (Veo clips).
//
// `asset_baker` alone reads this file; the simulation and the client never do. A Veo prompt is
// composed as: the identity's authored `veo_prompts[State]` (units.ron, structures.ron), then
// the action text below for that state and the identity's drawing kind (`unit_sphere` or
// `building_dome`, or the identity's override), then the style sentence. A clip's negative
// prompt is the global one of `media/veo_request.ron` plus its kind's `negative_terms`.
// Editing this file changes every future prompt and needs no rebuild (charter §3.3). Clips
// that already exist are not regenerated for a change here.
//
// The rules below are checked by `asset_baker validate-prompts`, and by `generate-veo` before it
// reads any credential, for every clip a run would pay for.
(
    // Ends every prompt. It describes the look in plain words and names no game, studio, show
    // or franchise (see `deny_list`). It avoids "cinematic", "hero framing" and "portrait",
    // which invited camera moves, and asks for a plain backdrop: "radial studio backdrop" gave
    // radiating stripes, which the owner rejected (2026-11-04).
    style: "Stylized hand-painted 3D character, painterly sci-fi aesthetic with crisp rim lighting, plain flat uniform dark slate-indigo studio backdrop (#0B101B) with no pattern, no rays, no stripes and no gradient, 3/4 isometric front view, glowing cyan/amber energy cores, bold proportions.",

    // Action text per drawing kind, placed between the identity's prompt and the style
    // (docs/plans/2026-11-04-veo-structure-action-text.md, D-1 and D-2). It mirrors `framing`:
    // `unit_sphere` for mobile units, `building_dome` for structures, then per-identity
    // overrides. Every state an identity publishes needs a text for its kind or an override,
    // and every text is checked like a prompt (deny list, placeholder markers).
    // - texts: one text per animation state.
    // - negative_terms: plain nouns appended, after ", ", to the global `negative_prompt` of
    //   `media/veo_request.ron` for every clip of the kind. `None` adds nothing.
    actions: (
        // Mobile units. A golden list of the unit prompts' SHA-256 guards these texts. Idle and
        // Walk loop in the game, so they ask for a fixed camera and an end pose equal to the
        // start pose (owner, Q0026: jumps when a loop restarts are distracting). Constructing is
        // kept in case a unit ever publishes it; it shows work in progress on the finished shape
        // (keyframe chaining).
        // Cast (reviewed in batch 4, 2026-11-05): the atlas loops Cast and the policy pins both
        // ends, so the text now has the camera and loop clauses Idle and Walk have, and the
        // body and tools hold still. The earlier "tool arms reaching toward a target" moved the
        // pose away from the picture the clip must return to (batch 2, welder_drone, whose
        // override this text now follows). A Cast whose effect is steady (a beam, an arc)
        // still needs its own pin with the effect lit (batch-2 evidence).
        unit_sphere: (
            texts: {
                Constructing: "Constructing animation, one static tripod shot: the camera never moves, zooms or pans. Construction work in progress over the whole structure, holographic wireframe scaffolding shimmering around it with active seam welding sparks. The structure keeps its shape, size and place in frame, and the last frame matches the first.",
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size and place in frame from start to end. Steady rhythmic breathing movement, subtle weapon glow pulse, head and radar scanning smoothly in place. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans, and the subject moves in place, keeping the same size and place in frame. Dynamic forward stride, rhythmic mechanical bobbing, ground dust kick-up at feet, leaning into movement. Seamless loop: the last frame matches the first.",
                Attack: "Attack animation: sharp weapon recoil, intense bright muzzle flash and projectile emission filling the right side of frame, followed by fluid spring recovery.",
                Cast: "Cast animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size, pose and place in frame from start to end. It holds a steady bright work beam or extraction arc toward a point just outside the frame, with showering sparks, its body and tools holding still. Seamless loop: the last frame matches the first.",
                Die: "Death animation: dramatic armor fracture, glowing internal reactor blowout with flying mechanical debris dissolving into smoke.",
            },
            // "Breathing" is asked for above, so it cannot be a negative term for units.
            negative_terms: None,
        ),
        // Structures. Idle is a completely still building: fixed geometry, small ambient
        // effects only, no moving parts, no breathing or pulsing of the shape, and a locked
        // camera. The unit Idle text ("breathing", "radar scanning", "glow pulse") gave a
        // breathing camera and a changing antenna on the siphon pilot (batch-1 evidence).
        // Constructing shows the build-up on the finished shape with no camera motion, and its
        // effects fade so that its last frame equals the clean Idle pin (loops plan D-3).
        building_dome: (
            texts: {
                Constructing: "Constructing animation, one locked-off static shot: the camera never moves, zooms or drifts. The finished building keeps its final shape, size and place in frame throughout while construction plays over it: holographic wireframe scaffolding shimmering around it and welding sparks along its seams, fading away toward the end. The last frame matches the first.",
                Idle: "Idle animation, one locked-off static shot: the camera never moves, zooms or drifts. A completely still building, fixed rigid geometry, no moving parts: shell, roof, antenna and pipes keep the same shape, size and place throughout. Only small ambient effects move: a steady glow, gentle vapour rising, small lights flickering. Seamless loop: the last frame matches the first.",
            },
            // Not in the global list: units ask for breathing. "Flickering geometry" is left
            // out, because a negative "flickering" may suppress the lights Idle asks for.
            negative_terms: Some("breathing motion, pulsing size, swelling, shrinking, moving parts, rotating parts, antenna changing shape"),
        ),
        // Exact catalog slug -> state -> text, for one identity whose clip needs other wording.
        // An override keeps its kind's negative terms. A slug that is not in the catalog, or a
        // state the identity does not publish, is refused.
        //
        // repair_shuttle (batch 1, 2026-11-04): an unarmed aircraft. The unit Idle text asks for
        // a weapon glow and a scanning head, and the unit Walk text for a stride and dust at the
        // feet, none of which it has. Both of its looping states start and end on its hovering
        // Idle pin, so they keep that pose and show motion through the thrusters.
        //
        // welder_drone (batch 2, 2026-11-04): a hovering worker armed with a melee welding torch.
        // The unit Idle text asks for a weapon glow and a scanning head (a turning part), the
        // unit Walk text for a stride and dust at the feet, and the unit Attack text for a muzzle
        // flash and a projectile; it has none of these. The unit Cast text has no camera clause
        // and no loop clause although the atlas loops Cast and the policy pins its end, and its
        // "tool arms reaching" moves the pose away from the pin it must return to. Idle, Walk and
        // Cast start and end on the hovering Idle pin, so they keep that pose; Attack starts on it.
        //
        // railgun_crawler, shock_golem, jet_jumper, specter_android (batch 3, 2026-11-05): the
        // barracks' combat units. The unit Idle text asks for "head and radar scanning", a
        // turning part that batch 1 saw flicker and change shape; the unit Walk text asks for
        // "ground dust kick-up at feet", and words about the ground drew a floor plane in
        // batch 2; the unit Attack text has no camera clause and ends nowhere in particular.
        // Their Idle and Walk start and end on the Idle pin and Attack starts on it, so each
        // text keeps the pose, faces the weapons one way and returns to the start. The
        // crawler is a tracked tank: no feet, a fixed turret, the tracks show the travel.
        // Batch 4 (2026-11-05) redesigned it from text with no side vents (its first pin's
        // side exhaust flames flickered in five Walks) and asked its Walk for tracks running
        // fast on a rolling road with exhaust streaming backward; the golem's Walk asks for a
        // brisk march with high knee lifts (marking time read as a weight shift).
        overrides: {
            "railgun_crawler": {
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the tank keeps the same size and place in frame from start to end. The tank sits still with its engine idling: thin exhaust smoke drifts slowly from its two rear stacks and blue energy glows steadily along the rails. The turret, both barrels and the tracks stay fixed. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans, and the tank drives at full speed on a rolling road that holds it in place: all four tracks run fast and continuously, treads and road wheels visibly moving the whole time, while the hull keeps the same place, size and facing in frame. The hull vibrates on its suspension and exhaust smoke streams backward from its two rear stacks; the turret stays fixed. Seamless loop: the last frame matches the first.",
                Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the tank keeps its place in frame with the turret fixed. The twin rails fire once along the barrels: a sharp recoil, a bright blue electric flash at the muzzles and a bolt streaking out of frame, then the barrels settle back to their starting position.",
            },
            "shock_golem": {
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size, pose and place in frame from start to end. It stands still and steady in place, holding its fire: its body barely moves and only its lights change, optics glowing and energy cores pulsing softly; head and weapons keep facing the same way. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans. The golem marches briskly on the spot as if on a treadmill: four full steps, left, right, left, right, each knee lifting high and each foot stamping down again at an even pace from the first frame to the last, while its body keeps the same place, size and three-quarter facing in frame and never leans toward the camera. Weapons held ready; nothing else appears in the frame. Seamless loop: the last frame matches the first.",
                Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps its place in frame. It fires along the line its weapons point: a sharp recoil, bright muzzle flashes and shells streaking out of frame, then it settles smoothly back to its starting pose.",
            },
            "jet_jumper": {
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size, pose and place in frame from start to end. It stands still and steady in place, holding its fire: its body barely moves and only its lights change, optics glowing and energy cores pulsing softly; head and weapons keep facing the same way. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans, and the subject runs on the spot as if on a treadmill: its legs step in turn while its body keeps the same place, size and three-quarter facing in frame throughout. A steady rhythmic stride with a slight mechanical bob, weapons held ready. Seamless loop: the last frame matches the first.",
                Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps its place in frame. It fires along the line its weapons point: a sharp recoil, bright muzzle flashes and projectiles streaking out of frame, then it settles smoothly back to its starting pose.",
            },
            "specter_android": {
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size, pose and place in frame from start to end. It stands still and steady in place, holding its fire: its body barely moves and only its lights change, optics glowing and energy cores pulsing softly; head and rifle keep facing the same way. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans, and the subject marches on the spot as if on a treadmill: its legs step in turn while its body keeps the same place, size and three-quarter facing in frame throughout. A steady rhythmic stride with a slight mechanical bob, rifle held ready. Seamless loop: the last frame matches the first.",
                Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps its place in frame. It fires once along the line its rifle points: a sharp recoil, a bright muzzle flash and a beam streaking out of frame, then it settles smoothly back to its starting pose.",
            },
            "welder_drone": {
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size and place in frame from start to end. The robot hovers in place with a gentle steady bob, its optic eye glowing, a small blue pilot flame flickering at the welding torch tip. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans, and the robot flies in place, keeping the same size, pose and place in frame. Its back thrusters flare in steady bursts, exhaust streams backward, a slight rhythmic bob, no ground contact. Seamless loop: the last frame matches the first.",
                Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the robot keeps its place in frame. A quick close-range jab of its welding torch arm toward the right side of the frame, a burst of bright orange sparks at the tool tip, then the arm swings back to its starting pose.",
                Cast: "Cast animation, one static tripod shot: the camera never moves, zooms or pans, and the robot hovers in place keeping the same size, pose and place in frame. Its welding torch holds a steady bright welding arc toward a point just outside the frame, with showering sparks, and its claw glows softly. Seamless loop: the last frame matches the first.",
            },
            "repair_shuttle": {
                Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the subject keeps the same size and place in frame from start to end. The aircraft hovers in place with a gentle steady bob, thrusters glowing, nanite emitters shimmering softly. Seamless loop: the last frame matches the first.",
                Walk: "Walk animation, one static tripod shot: the camera never moves, zooms or pans, and the aircraft flies in place, keeping the same size, pose and place in frame. Thrusters flare in steady bursts, exhaust streams backward, a slight rhythmic bob, no ground contact. Seamless loop: the last frame matches the first.",
            },
        },
    ),

    // Longest composed prompt accepted, in characters. The model's own limit is not published
    // for veo-3.1-*-001 (docs/evidence/veo/2026-11-04-api-notes.md); this keeps prompts short.
    max_prompt_chars: 1024,

    // Names of real games, studios, shows and franchises a prompt must not contain. Matched as
    // whole words or phrases, ignoring case.
    deny_list: [
        "StarCraft",
        "Blizzard",
        "Arcane",
        "Riot Games",
        "League of Legends",
        "Warcraft",
        "Warhammer",
        "Zerg",
        "Protoss",
        "Terran",
        "Star Wars",
        "Marvel",
        "Disney",
        "Pixar",
        "Gundam",
        "Transformers",
        "Nintendo",
    ],

    // Text that marks an unfinished prompt. A marker made of letters matches as a whole word
    // ignoring case; any other marker matches anywhere.
    placeholder_markers: ["TODO", "TBD", "FIXME", "XXX", "lorem", "ipsum", "placeholder", "{", "}"],

    // How `asset_baker` fits a clip (Veo returns 16:9) into the square game frame, chosen by
    // the identity's render shape (docs/plans/2026-11-04-veo-letterbox-bake.md, D-1 to D-3).
    // - CenterCrop: cut the centred square; a wide subject loses its sides.
    // - Letterbox(feather_permille: N): keep the whole frame, scaled to fit, with opaque bars in
    //   the colour measured from the clip's own border; the content's outermost N/1000 of the
    //   frame side blends into the bars (0 leaves a hard edge).
    framing: (
        // Units are taller than wide and centred, so the crop keeps them whole and large.
        unit_sphere: CenterCrop,
        // Structures are wide and Veo fills the 16:9 width with them; a crop cuts their base.
        building_dome: Letterbox(feather_permille: 30),
        // Exact catalog slug -> framing, for one identity whose clip needs the other treatment
        // (for example a wide flying unit). A slug that is not in the catalog is refused.
        //
        // repair_shuttle (batch 1, 2026-11-04): a wide twin-engine aircraft seen at 3/4; its
        // first clip (62f8d6c9) spans about 60 % of the 16:9 width, so the centre crop cut
        // off an engine pod. Letterboxed like a structure, it stays whole.
        //
        // welder_drone (batch 2, 2026-11-05): a wide worker seen at 3/4 with its welding torch
        // held out to one side; its first clip (d020071b) spans about 68 % of the 16:9 width,
        // so the centre crop cut off the torch. Letterboxed like the shuttle, it stays whole.
        //
        // railgun_crawler, shock_golem, jet_jumper, specter_android (batch 3, 2026-11-05): seen
        // at 3/4 with their weapons held out to the side (the tank's long barrels, the golem's
        // arm cannons, the hound's two pistols, the android's long rifle), each spans about 60
        // to 65 % of the 16:9 width and sits left of centre in its first clips (97931437,
        // c6ddca3c), so the centre crop cut off a weapon. Letterboxed, they stay whole.
        overrides: {
            "repair_shuttle": Letterbox(feather_permille: 30),
            "welder_drone": Letterbox(feather_permille: 30),
            "railgun_crawler": Letterbox(feather_permille: 30),
            "shock_golem": Letterbox(feather_permille: 30),
            "jet_jumper": Letterbox(feather_permille: 30),
            "specter_android": Letterbox(feather_permille: 30),
        },
    ),

    // How each state is made seamless (docs/plans/2026-11-04-veo-seamless-loops.md, D-1).
    // Every state the atlas loops (Idle, Walk, Cast) needs an entry; a state the atlas does not
    // loop may only set `pin_end`.
    // - pin_end: the start request sends the state's start picture also as `lastFrame`, so the
    //   clip must end on the picture it starts from. Vertex AI only; the picture must be PNG or
    //   JPEG, 16:9 within 1 %, at least 1280x720 and at most 20 MB.
    // - seam: repair done by the baker on the kept frames, in this order: scale lock (undo a
    //   steady camera zoom), then a cross-fade of the last N frames back into frame 0. N is at
    //   most 4 and at most a quarter of the frames the atlas keeps per state.
    loops: (
        states: {
            Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 2))),
            Walk: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 2))),
            Cast: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 2))),
            // Held on its last frame, not looped: pinned so that it ends on the picture Idle
            // starts from, and the switch to Idle on completion is seamless (D-3).
            Constructing: (pin_end: true, seam: None),
        },
        // Exact catalog slug -> state -> treatment, for one identity whose clip needs another
        // one. A slug that is not in the catalog is refused (as `framing.overrides`).
        //
        // repair_shuttle Idle (batch 1, 2026-11-04): its hover bob already loops (raw wrap as
        // high as the median step), and a cross-fade blends two bob positions into a double
        // image at the restart, so this clip keeps the scale lock and no cross-fade.
        // repair_shuttle Walk: pinned at both ends, its raw frames already loop; the hover bob
        // moves the hull up and down, which the scale lock reads as an uneven zoom and refuses.
        // There is no camera zoom to undo, so Walk keeps loop sampling only.
        // welder_drone Idle (batch 2, 2026-11-05): the same hover bob as the shuttle's. Its first
        // clip (d020071b) loops raw (wrap 0.907 above the median step 0.730 of its 8 kept
        // frames), and the default cross-fade of 2 of those 8 frames blends two bob positions
        // and fails (worst 0.723 < 0.805), so it keeps the scale lock and no cross-fade.
        // welder_drone Walk: pinned at both ends to the Idle frame 0; the default cross-fade of 2
        // of 8 frames shows a double image of the whole robot at the restart (the bob moves the
        // body by a few per cent of the frame), so it keeps loop sampling only, as the shuttle.
        //
        // railgun_crawler, shock_golem, jet_jumper, specter_android Attack (batch 3, 2026-11-05):
        // a one-shot that the game follows with Idle. Unpinned, the first Attack clips of the
        // golem (deab733a) and the hound (dfae7358) fired well and then lowered their weapons,
        // ending in a pose the Idle does not start from, so the switch back would snap. Their
        // Attack is pinned at its end to the Idle picture, as Constructing is (D-3), and is
        // still not looped.
        // specter_android Walk: pinned at both ends, its raw frames already loop (74014f87: raw
        // worst 0.800 against a threshold of 0.782); the default cross-fade of 2 of 10 frames
        // shows a double image of the legs at the restart, as on the welder, so it keeps loop
        // sampling only. jet_jumper Walk likewise: its raw frames loop (503ded63: raw worst 0.737
        // against 0.724, growth 1.45 %), and the scale lock reads the hopping stride as an
        // uneven zoom and refuses it although the camera does not move.
        // railgun_crawler Idle: pinned at both ends, its raw frames already loop (6eedaf3a: raw
        // wrap 0.940 above the median step 0.936, worst 0.909 against 0.906); a cross-fade of
        // the drifting smoke raises the median step and fails it by 0.0003, so it keeps the
        // scale lock and no cross-fade, as the shuttle and the welder. The redesigned crawler's
        // Idle (batch 4, 8d430dda) loops raw as well (wrap 0.926, worst 0.921 against 0.904).
        // shock_golem Walk (batch 4): pinned at both ends to the wide-stance Idle picture, eight
        // Walks barely stepped, stepped unevenly or leaned toward the camera; the end is left
        // free so the march can run through the clip, and loop sampling picks the loop with
        // a short cross-fade. The scale lock is off because a stride reads as an uneven zoom.
        overrides: {
            "railgun_crawler": {
                Attack: (pin_end: true, seam: None),
                Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
            },
            "shock_golem": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: false, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "jet_jumper": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "specter_android": {
                Attack: (pin_end: true, seam: None),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "welder_drone": {
                Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "repair_shuttle": {
                Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
        },
    ),
)
