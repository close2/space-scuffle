                Attack: (pin_end: true, seam: None),
            },
            "volatile_tick": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "mortar_stag": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "thorn_viper": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "stag_behemoth": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "hive_matron": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                Attack: (pin_end: true, seam: None),
            },
            "mycelium_shaman": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
            },
            "sonic_bat": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Attack: (pin_end: true, seam: None),
            },
            "sky_leviathan": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
                Attack: (pin_end: true, seam: None),
            },
            "tongue_chameleon": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
            },
            "amber_pollen_dome": {
                Walk: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 2))),
            },
        },
    ),

    // Media of units' catalog modes (docs/plans/2026-11-09-effect-visualization.md WP13,
    // Amendment 10; owner answer Q0075). Exact catalog slug, then the catalog `mode_name`, then:
    // - look: the unit's look for these prompts, replacing its Idle `veo_prompts` entry (optional);
    // - enter / leave: the morph into the mode and back to the default stance;
    // - texts: one text per state the client shows in the mode (Idle always, Attack when the
    //   unit is armed in it, Walk when the mode is not immobile, Cast for a worker);
    // - loops: as the `loops` section above, for the mode's states.
    // A clip's prompt is: look, then the slice's text, then `style`. The pictures chain the clips:
    // the enter morph starts on the unit's Idle picture and its last frame becomes the mode's
    // picture (`<slug>-<mode>.png` among the keyframes); every state in the mode starts on it;
    // the leave morph starts on it and ends on the Idle picture. A unit or mode not named here
    // keeps its default clips in every stance.
    modes: {
        "railgun_crawler": {
            "siege_mode": (
                enter: "Deploying animation, one static tripod shot: the camera never moves, zooms or pans, and the tank keeps its place, size and three-quarter facing in frame. It deploys into artillery mode: four heavy hydraulic stabilizer legs swing out from the hull corners and brace down, the hull lowers and locks, and the twin rail barrels tilt up to a steep firing angle, glowing steadily blue, the muzzles inside the frame. Nothing fires: no sparks, no lightning, no discharge. It ends fully deployed and still.",
                leave: "Packing-up animation, one static tripod shot: the camera never moves, zooms or pans, and the tank keeps its place, size and three-quarter facing in frame. The deployed tank packs up for travel: the long twin rail barrels tilt down level, pointing forward, and slide back to their normal length, the hull rises, and the four stabilizer legs fold back into the hull corners. Nothing fires. It ends still, ready to drive.",
                texts: {
                    Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the deployed tank keeps the same size, pose and place in frame from start to end. It stands anchored on its four braced stabilizer legs with the long twin rail barrels raised, completely still; only the blue glow along the rails pulses slowly and thin smoke drifts from its stacks. Nothing fires: no sparks, no lightning. Seamless loop: the last frame matches the first.",
                    Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the deployed tank keeps its place in frame on its braced legs. The twin rail barrels stay locked at their steep upward angle the whole time and never lower or turn. They fire one massive shot together: a short recoil along the barrels, a compact bright blue muzzle flash at their tips that stays inside the frame, a puff of smoke, then the glow settles.",
                },
                loops: {
                    Idle: (pin_end: true, seam: Some((scale_lock: true, crossfade_frames: 0))),
                    Attack: (pin_end: true, seam: None),
                },
                // The raised rails and the muzzle blast rose above the default frame and were
                // cut by its top edge (independent review of WP13, item 1). The clips start on
                // the Idle picture shrunk to 70 % with a margin of its backdrop; the bake crops
                // them back to the default atlas's scale and keeps the margin above the hull.
                // picture_feather_permille is the start picture's blend into its margin, not the
                // bake's bar feather (the unit's letterbox feather above).
                reframe: Some((scale_permille: 700, picture_feather_permille: 60)),
            ),
        },
        "burrow_scorpion": {
            "burrowed": (
                look: Some("Subterranean Ambush Scorpion: one broad, flat armored scorpion of thick brown chitin with six short legs, two broad pincer claws, a spined tail and glowing amber bands along its back, seen from high above at a three-quarter angle, head toward the lower right, centred in evenly lit empty space."),
                enter: "Burrowing animation, one static tripod shot: the camera never moves, zooms or pans. The scorpion digs straight down on the spot, staying one whole, intact body with every leg and claw attached: its legs and claws churn and fling loose dark earth, and it sinks into a growing mound of soil until only a low round mound of dark earth remains, the glowing amber bands of its back and the tip of its spined tail showing through. It ends still.",
                leave: "Unburrowing animation, one static tripod shot: the camera never moves, zooms or pans. The mound of dark earth bursts open and the scorpion heaves itself up out of the soil, shaking off loose earth, unfolding its legs and claws and raising its spined tail; the soil falls away and vanishes until it crouches alone and still in empty space.",
                texts: {
                    Idle: "Idle animation, one static tripod shot: the camera never moves, zooms or pans, and the mound keeps the same size and place in frame. A low round mound of loose dark earth hides the buried scorpion: only the glowing amber bands of its back and the tip of its spined tail show through the soil, completely still, the amber glow pulsing softly. Seamless loop: the last frame matches the first.",
                    Attack: "Attack animation, one static tripod shot: the camera never moves, zooms or pans, and the mound keeps its place in frame. The buried scorpion strikes: the mound heaves and a straight row of jagged bone spikes bursts up in a quick ripple from the mound toward the right edge of the frame, then the spikes sink away and the mound settles back to its starting look.",
                },
                loops: {
                    Idle: (pin_end: true, seam: Some((scale_lock: false, crossfade_frames: 0))),
                    Attack: (pin_end: true, seam: None),
                },
            ),
        },
    },

    // Prompt class "effect element" (docs/plans/2026-11-09-effect-visualization.md §6.1 to §6.4):
    // greyscale shape and shading of one isolated effect element on pure black, for the image
    // model (stills, decals) and for Veo (camera-facing flipbooks). Colour, size and timing come
    // from the engine, so the prompt asks for no colour scheme and no scene. An effect request
    // names a texture set and an element, never a unit. A prompt is composed as: the request's
    // own description, then the view text, then the medium text (`still` or `clip`), then
    // `style`; it is checked like a unit prompt (deny list, placeholder markers, length).
    // - on_white_edit: the edit request that renders the same element on pure white, the second
    //   picture of a difference-matte pair (§6.4).
    // - negative_terms: nouns a clip request appends to the global negative prompt.
    effect_element: (
        style: "Isolated single visual effect element, centred with empty margin on every side, on a pure black background (#000000). Nothing else in frame: no floor, no ground plane, no horizon, no light rays, no god rays, no stripes, no gradient, no vignette, no text. Neutral white light, soft natural detail, photographic quality.",
        side_on: "Seen side-on at eye level, the element rising from an invisible base line near the lower third of the frame.",
        top_down: "Seen from directly above in a top-down orthographic view, the element lying flat and filling the middle of the frame.",
        still: "A single still image, sharp focus, square format.",
        clip: "One static tripod shot: the camera never moves, zooms or pans. The frame starts pure black, the element appears, develops and fully dissipates back to pure black before the clip ends.",
        on_white_edit: "Render exactly the same element with the same shape, position, size, lighting and detail on a pure white background (#FFFFFF) instead of black. Change nothing else.",
        negative_terms: "floor, ground, horizon, light rays, stripes, gradient, vignette, text, watermark, scenery",
    ),
)
