        },
        // Exact catalog slug -> plain nouns appended after its kind's negative terms, for one
        // identity whose clips keep drawing something its kind's clips need not avoid (owner
        // answers Q0131 (a), Q0133; plan 2026-11-28-broodlings WP6). A slug that is not in the
        // catalog, or blank terms, is refused.
        // spore_matriarch: its first four seeds drew light shafts from above and flapped their
        // wings; brood_mite: its pinned Idles nodded their heads and flushed in colour.
        // mothership_carrier, saucer_interceptor: their first four seeds each drew diagonal light
        // shafts across the backdrop (carrier batch, Q0131 (a)).
        negative_overrides: {
            "mothership_carrier": "light shafts, tractor beam, beam of light from above, volumetric light, haze, light streaks",
            "saucer_interceptor": "light shafts, tractor beam, beam of light from above, volumetric light, haze, light streaks",
            "spore_matriarch": "light shafts, tractor beam, beam of light from above, volumetric light, haze, flapping wings",
            "brood_mite": "head turning, nodding, twitching, colour change",
        // Batch 2 (docs/media/veo-video-requests-batch-2.md): every aircraft, drone and flyer
        // takes the light-shaft terms of the Carrier and the interceptor (a beam-casting drone
        // keeps its own beam: no "tractor beam" or "light streaks"); every Swarm creature the
        // Broodling's terms plus "floor, cast shadow"; the Greys "head turning, nodding, floor,
        // cast shadow"; the walkers "floor, cast shadow, turning toward the camera" (the mech's
        // Walks turned); the sphere drone in fixed rings "rotating rings, spinning rings"; every
        // structure "floor, ground plane, cast shadow, horizon" (batch 1 to 4 seeds drew lit
        // floors, horizons and hard shadows).
            "flying_saucer": "light shafts, tractor beam, beam of light from above, volumetric light, haze, light streaks",
            "grav_harvester": "light shafts, beam of light from above, volumetric light, haze",
            "warp_strider": "floor, cast shadow, turning toward the camera",
