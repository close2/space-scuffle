// assets/catalog/placement_rules.ron
// Resource node footprints (StarCraft II Patch 5.0.14, SC2GameData 5444e12f13; plans
// docs/plans/2026-11-19-footprint-flags.md D-2 and docs/plans/2026-11-20-resource-footprints.md
// D-1).
//
// Each row is the game's `Place` layer, copied: `x` is one of the node's own cells (its
// footprint: nothing is built or spawned there), `o` a cell of its ring, `.` neither; the node
// applies the flags of `applies` on its `x` and `o` cells. `rows[0]` is the row of lowest y, and
// `anchor` is the (column, row) of the cell the map file names. `shape` is the pathing shape (the
// game's `Shape`) in world units from the centre of the `x` cells: `Box` a box with 45-degree
// corners cut by `chamfer`, `Outline` a vertex list in order round the outline. A structure whose
// `placement_excludes` in structures.ron names a flag cannot be placed on a cell that carries it.
//
// Each row also carries the resource's harvest data, from the same 5.0.14 CBehaviorResource
// record as `remove_when_empty` (plan docs/plans/2026-11-22-harvest-timing.md D-2):
// `harvest_time_ticks` (HarvestTime) a worker gathers, `harvest_amount` (HarvestAmount) it takes
// and `return_delay_ticks` (ReturnDelay) it waits at the node holding its load before it walks
// back. Times are whole ticks at 25 per Faster second: t Normal seconds is round(t / 1.4 * 25),
// halves up.
(
    resource_footprints: [
        // 5.0.14 FootprintMineralsRounded (liberty Footprint:1061-1096; liberty UnitData:68). Place
        // rows :1083-1089, read with rows[0] the lowest y: `x` the field's own 2x1, `o` the
        // NearResources ring. The anchor is the field's west cell, the map file's `cell`. Shape
        // Offsets :1094 (a 2 x 1 box). RemoveWhenEmpty: liberty BehaviorData:749.
        (kind: Mineral, applies: [NearResources], anchor: (3, 3), rows: [
            ".oooooo.",
            "oooooooo",
            "oooooooo",
            "oooxxooo",
            "oooooooo",
            "oooooooo",
            ".oooooo.",
        ], shape: Box(half_width: 1.0, half_height: 0.5, chamfer: 0.0), remove_when_empty: true,
            // MineralFieldMinerals (liberty BehaviorData:743-756): HarvestTime 2.786 Normal s = 49.75
            // ticks, HarvestAmount 5, ReturnDelay 0.5 Normal s = 8.93 ticks (S-5 whole-tick rounding);
            // no later layer changes them.
            harvest_time_ticks: 50, harvest_amount: 5, return_delay_ticks: 9),
        // 5.0.14 FootprintGeyserRounded (liberty Footprint:1535-1576, rows 0, 1, 7 and 8 and
        // Shape as void Footprint:3-21; liberty UnitData:2127). The anchor is the centre cell (the
        // extractor's 3x3 is centred on it). Shape: void Footprint:18-19, the +-1 square with its
        // corners pushed out into diagonal lobes. No RemoveWhenEmpty (liberty BehaviorData:801-807).
        (kind: Gas, applies: [NearResources], anchor: (4, 4), rows: [
            "..ooooo..",
            ".ooooooo.",
            "ooooooooo",
            "oooxxxooo",
            "oooxxxooo",
            "oooxxxooo",
            "ooooooooo",
            ".ooooooo.",
            "..ooooo..",
        ], shape: Outline([
            (-0.5, -1.0), (-0.75, -1.25), (-1.25, -0.75), (-1.0, -0.5),
            (-1.0, 0.5), (-1.25, 0.75), (-0.75, 1.25), (-0.5, 1.0),
            (0.5, 1.0), (0.75, 1.25), (1.25, 0.75), (1.0, 0.5),
            (1.0, -0.5), (1.25, -0.75), (0.75, -1.25), (0.5, -1.0),
        ]), remove_when_empty: false,
            // HarvestableVespeneGeyserGas (liberty BehaviorData:817-852, the three races alike): HarvestTime
            // 1.981 Normal s = 35.375 ticks, HarvestAmount 4; no ReturnDelay.
            harvest_time_ticks: 35, harvest_amount: 4, return_delay_ticks: 0),
    ],
)
