                    prompt: "Seamless tileable top-down texture of grey-brown alien regolith dust with small pebbles and fine cracks, stylized hand-painted RTS ground, even diffuse lighting, no perspective, no text, square",
                ),
                cliff: (
                    name: "basalt_wall",
                    source: "source_art/terrain/orbital_foundry/basalt_wall.png",
                    metallic: 0.05,
                    roughness_range: (0.55, 0.90),
                    normal_strength: 4.0,
                    prompt: "Seamless tileable texture of a vertical dark basalt cliff face with layered strata and fractures, subtle bluish mineral veins, stylized hand-painted sci-fi RTS cliff, front view, even diffuse lighting, no sky, no text, square",
                ),
            ),
            backdrop: (
                source: "source_art/terrain/orbital_foundry/void_nebula.png",
                prompt: "Deep space backdrop, very dark navy void with faint purple and teal nebula wisps and sparse tiny stars, seamless, no planets, no text, square",
