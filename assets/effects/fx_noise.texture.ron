    ],
    elements: [
        (
            name: "noise_tile",
            first_layer: 0,
            frames: 1,
            duration_ms: None,
            pivot_px: (128, 128),
            blend: Data,
            channel_labels: Some(("perlin", "worley", "curl_x", "curl_y")),
        ),
        (
            name: "ring_noise",
            first_layer: 1,
            frames: 1,
            duration_ms: None,
            pivot_px: (128, 128),
            blend: Data,
            channel_labels: Some(("ring_mask", "perlin", "worley", "constant")),
        ),
        (
            name: "fire_noise",
            first_layer: 2,
            frames: 1,
            duration_ms: None,
            pivot_px: (128, 128),
            blend: Data,
            channel_labels: Some(("perlin", "value", "worley", "constant")),
        ),
        (
            name: "erosion_gradient",
            first_layer: 3,
            frames: 1,
            duration_ms: None,
            pivot_px: (128, 128),
            blend: Data,
            channel_labels: Some(("erosion_gradient", "erosion_gradient", "erosion_gradient", "constant")),
        ),
    ],
)
