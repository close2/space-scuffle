// Frame-budget measurement specification, read at run time by the `frame_budget` tool
// (crates/client_diagnostics/src/frame_budget). Plan: docs/plans/2026-11-03-close-phase-6-7-8-exits.md,
// decision D-4 and work package WP5.
//
// The tool copies the real assets root into a work directory and writes into that copy a flat map,
// one start loadout per scenario and one scenario file per entry of `scenarios`. Nothing here is
// shipped to players and nothing in the repository's `assets/` changes.
//
// Two armies: every scenario has the same two players, opposite each other, both attack-moving to
// the arena's centre cell (64, 64), and differs only in units per player: 0, 100 and 200 (0, 200
// and 400 units). The armies meet in the middle and in view, the survivors stop there and no town
// hall falls, so the match lasts the whole measured window (plan Amendment 2: sent to each other's
// start, one army won and destroyed the other hall at tick 1,087 or 1,434).
// The production scenario path places a player's units on rings 1 to 3 around its 5x5 town hall
// (96 cells) and continues on rings 4, 5, ... when those are full, so 200 units fill rings 1 to 5,
// a 15x15 block around each hall. Owner's answer to Q0018, option (b):
// docs/questions/open/0018-frame-budget-army-layout.md, and the plan
// docs/plans/2026-11-11-scenario-outer-rings.md. Until 2026-11-11 the scenarios used eight players
// of 0, 25 and 50 units on a circle; those figures stay in docs/evidence/2026-11-03-frame-budget.md.
(
    format_version: 1,
    // The shipped loadout whose unit mix is scaled to `units_per_player`, with largest-remainder
    // rounding. Its town hall and starting bank are kept.
    source_loadout: "battle_automaton",
    seed: 1592639215,
    map: (
        file: "maps/frame_budget_arena.scmap.ron",
        title: "Frame Budget Arena",
        description: "Flat measurement arena for the frame_budget tool; generated, never shipped.",
        width: 128,
        height: 128,
        theme: "orbital_foundry",
        start_footprint: (5, 5),
    ),
    // Start cells are the top-left cells of the footprints: slots 0 and 4 of the former eight-player
    // circle around (64.5, 64.5), 44 cells apart on one row. `target_cell` overrides the attack-move
    // to `target_slot`'s start.
    players: [
        (slot: 0, start_cell: (84, 62), target_slot: 1, target_cell: Some((64, 64))),
        (slot: 1, start_cell: (40, 62), target_slot: 0, target_cell: Some((64, 64))),
    ],
    // The 0 scenario keeps the two town halls and fields no unit: the baseline of map, smog, HUD
    // and presentation with nothing moving, for this scene (not comparable with the former
    // eight-hall baseline).
    scenarios: [
        (name: "0", units_per_player: 0),
        (name: "200", units_per_player: 100),
        (name: "400", units_per_player: 200),
    ],
    // A fixed pose over the arena, in world units (one unit is one grid cell; `target` is the
    // ground point (x, z) the camera looks at). The far side of a 58-degree view reaches further
    // than the near side, so the target sits 8 cells toward the camera from the arena's centre.
    // Every unit of every army stays inside the 1280x720 view from this pose.
    camera: (target: (64.5, 72.5), distance: 75.0),
    // Frames rendered after the battle's media, map presentation and GPU pipelines are ready and
    // before measurement starts, with the battle paused, so pipeline compilation and first-use
    // uploads are excluded.
    warmup_frames: 180,
    // Simulation ticks measured (1,500 ticks are 60 s of game time at 25 ticks per second).
    measure_ticks: 1500,
    // Ticks of the combat window, from the first frame with a combat event.
    combat_window_ticks: 750,
    // Smallest share of live units that must be inside the view on every measured frame.
    min_in_view_fraction: 0.95,
    // Rows preallocated for the measured window; a longer window fails rather than allocate.
    max_recorded_frames: 200000,
)
