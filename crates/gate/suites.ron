// The suite catalog of `cargo gate`: which test targets a change can break.
//
// Blueprint: docs/plans/2026-11-04-tiered-test-gates.md, sections 3 and 4. Parsed by
// crates/gate/src/catalog.rs; checked against `cargo metadata` and the repository by
// crates/gate/tests/suite_catalog_tests.rs (charter check C22).
//
// Target names: `crate/lib` (unit tests of the library), `crate/bin/<name>` (unit tests of a
// binary), `crate/<file stem>` (an integration test under tests/), `crate/@<class>` (every target
// of that class in the crate). Globs are Git-style, relative to the repository root: `*` stays in
// one directory, `**` crosses directories, `{a,b}` lists alternatives.
//
// How a change selects (crates/gate/src/select.rs):
// - a path matching `global`, or a path nothing below covers, selects the complete suite;
// - a path matching `docs` selects nothing beyond fmt and `always`;
// - a path under crates/<c>/ selects every `fast` and `slow` target of <c> and `downstream[<c>]`;
// - a `gpu` or `valgrind` target runs when a changed path is one of its own source files (its
//   test file and every support file it loads with `#[path]`), matches one of its `triggers`, or
//   when a rule or downstream contract names it;
// - `rules` add targets for paths outside or across crates; `commands` add the golden replays.
//
// A `targets` entry may set `test_threads: Some(n)`: the gate then runs that executable with
// `--test-threads=n` instead of libtest's one thread per CPU, to bound its peak memory.
//
// When `cargo gate full` or CI finds a failure that `package` did not select, the fix adds the
// missing rule here in the same commit (blueprint section 3.5, step 4).
SuiteCatalog(
    // Workspace-wide inputs: any change selects the complete suite (P3). The patched naga and the
    // renderer compatibility tool have no narrower rule yet, so they are here too.
    global: [
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/**",
        "rust-toolchain*",
        "clippy.toml",
        "crates/*/Cargo.toml",
        "crates/*/clippy.toml",
        ".github/workflows/**",
        "crates/gate/**",
        "third_party/**",
        "tools/renderer_compatibility/**",
    ],

    // Text that no test reads except the charter checks, which `always` runs.
    docs: [
        "docs/**",
        "**/*.md",
        ".gitignore",
    ],

    // Every tier runs the charter checks.
    always: [
        "workspace_checks/@fast",
    ],

    // Every target that is not `fast` (blueprint section 3.2). Unlisted targets are `fast`.
    targets: {
        // Headless but long: the client's unit tests and the battle drivers that play the
        // shipped skirmish, whole matrices, ffmpeg. Each test of a client binary capped with
        // `test_threads` holds a whole Bevy app with the shipped atlases, so peak memory grows
        // with libtest's thread count: at 16 threads (one per CPU) most reached 12 to 28 GiB, and
        // four gates at once froze the server. Each cap is the thread count that keeps the
        // binary's peak RSS near 6 GiB in the least wall time, measured per binary at 16/4/3/2
        // threads (blueprint Amendments 2 and 4); every Veo batch raises these figures, so they
        // are re-measured when a binary's peak grows well past 6 GiB.
        "client/lib": (class: Slow),
        "client/battle_card_tests": (class: Slow, test_threads: Some(2)),
        "client/battle_card_path_tests": (class: Slow, test_threads: Some(2)),
        "client/battle_context_order_tests": (class: Slow, test_threads: Some(3)),
        "client/battle_flipbook_tests": (class: Slow, test_threads: Some(3)),
        "client/battle_fog_tests": (class: Slow, test_threads: Some(2)),
        "client/battle_hud_tests": (class: Slow, test_threads: Some(2)),
        "client/battle_input_tests": (class: Slow, test_threads: Some(2)),
        "client/battle_result_tests": (class: Slow, test_threads: Some(2)),
        "client/sync_steady_state_tests": (class: Slow, test_threads: Some(2)),
        "sim_core/sc2_who_wins_matchup_matrix_tests": (class: Slow),
        "asset_baker/procedural_tests": (class: Slow),
        "asset_baker/loop_check_tests": (class: Slow),
        "asset_baker/veo_cli_tests": (class: Slow),

        // GPU: every target that runs children through crates/client/tests/support/gpu_run.rs.
        // Each also runs when its own file or a support file it loads changes; the rules below
        // add the renderer, HUD-window, live-sync and shader paths. The caps below bound the
        // binaries whose in-process apps and children together passed 6 GiB (Amendment 4).
        "client/battle_hud_window_tests": (class: Gpu),
        "client/battle_result_window_tests": (class: Gpu),
        "client/combat_fx_slot_gpu_tests": (class: Gpu),
        "client/dome_fill_tests": (class: Gpu),
        "client/editor_app_tests": (class: Gpu, test_threads: Some(2)),
        "client/flipbook_clock_gpu_tests": (class: Gpu),
        // On lavapipe (CI) a GPU child keeps its textures in host memory and no GPU lock
        // serializes the children, so each test thread runs a whole client at once: four threads
        // reached 10.6 GiB of private memory (20 GiB of RSS) and lost the 16 GB CI runner; one
        // thread peaks at 4.1 GiB (Amendment 5). On radv the GPU lock serializes the children anyway.
        "client/gpu_validation_tests": (class: Gpu, test_threads: Some(1)),
        "client/lab_scene_tests": (class: Gpu, test_threads: Some(4)),
        "client/round2_visual_tests": (class: Gpu),
        "client/runtime_battle_tests": (class: Gpu),
        "client/skirmish_match_tests": (class: Gpu, test_threads: Some(2)),
        "client/smog_bouncing_bubbles_tests": (class: Gpu, test_threads: Some(2)),
        "client/terrain_tests": (class: Gpu),
        // The frame-budget smoke run renders the 400-unit scenario through the real renderer.
        "client_diagnostics/frame_budget_tests": (class: Gpu, triggers: [
            "crates/client/src/{bubble_shader.rs,bubble_optics.rs,render_compatibility.rs,flipbook_clock.rs,vfx.rs,vfx/**,smog/**,terrain/**,camera.rs}",
            "crates/client/tests/support/gpu_run.rs",
        ]),
        // The showcase smoke take renders a storyboard twice through the real renderer, HUD and
        // smog and compares the frames byte for byte.
        "client_diagnostics/showcase_tests": (class: Gpu, triggers: [
            "crates/client/src/{bubble_shader.rs,bubble_optics.rs,render_compatibility.rs,flipbook_clock.rs,vfx.rs,vfx/**,smog/**,terrain/**,camera.rs,battle_hud/**}",
            "assets/captures/showcase.ron",
            "assets/scenarios/showcase.ron",
            "crates/client/tests/support/gpu_run.rs",
        ]),
        // Its `shell_order_audit::gpu_tests` start the real renderer to check the pipeline cache.
        "client_diagnostics/lib": (class: Gpu, triggers: [
            "crates/client/src/{bubble_shader.rs,render_compatibility.rs}",
            "crates/client/tests/support/gpu_run.rs",
        ]),

        // Valgrind: counts the live battle sync's steady-state allocations.
        "client/sync_allocation_count_tests": (class: Valgrind, triggers: [
            "crates/client/src/{battle_pipeline/**,presentation.rs,runtime_battle/**,player_presentation/**}",
        ]),
    },

    // Path rules (blueprint section 4.2). The "test support" rule of the blueprint needs no
    // entry: a support file is an own file of every target that loads it, so a change to it
    // selects those targets whatever their class.
    rules: [
        (
            name: "GPU renderer",
            paths: ["crates/client/src/{bubble_shader.rs,bubble_optics.rs,render_compatibility.rs,flipbook_clock.rs,vfx.rs,vfx/**,terrain/**,smog/**,camera.rs,lab_stage.rs,scene_controller.rs,editor/**}"],
            targets: ["client/@gpu"],
        ),
        (
            name: "HUD windows",
            paths: ["crates/client/src/battle_hud/**", "crates/client/src/battle_presentation.rs"],
            targets: ["client/battle_hud_window_tests", "client/battle_result_window_tests"],
        ),
        (
            name: "live sync",
            paths: ["crates/client/src/{battle_pipeline/**,presentation.rs,runtime_battle/**,player_presentation/**}"],
            targets: [
                "client/sync_allocation_count_tests",
                "client/skirmish_match_tests",
                "client/runtime_battle_tests",
            ],
        ),
        (
            name: "shaders",
            paths: ["assets/shaders/**"],
            targets: [
                "client/@gpu",
                "client_diagnostics/@gpu",
                "client/headless_tests",
                "client/round2_visual_tests",
            ],
        ),
        (
            name: "catalog",
            paths: ["assets/catalog/**"],
            crates: ["sim_core", "sim_fixtures"],
            targets: [
                "asset_baker/runtime_catalog_tests",
                "asset_baker/media_tests",
                "asset_baker/provenance_tests",
                "asset_baker/prompt_tests",
                "client/player_presentation_tests",
                "client/runtime_media_tests",
                "client/lab_scene_tests",
                "client/round2_visual_tests",
                "client/battle_card_tests",
                "client_diagnostics/showcase_storyboard_tests",
            ],
        ),
        (
            name: "maps and scenarios",
            paths: ["assets/maps/**", "assets/scenarios/**"],
            crates: ["sim_map", "sim_core", "sim_fixtures"],
            targets: [
                "client/runtime_battle_tests",
                "client/skirmish_match_tests",
                "client/battle_fog_tests",
                "client/editor_core_tests",
                "client_diagnostics/showcase_storyboard_tests",
            ],
        ),
        (
            name: "media",
            paths: ["assets/{media,videos,textures,ai_keyframes,source_art}/**"],
            targets: [
                "asset_baker/media_tests",
                "asset_baker/bake_integrity_tests",
                "asset_baker/provenance_tests",
                "asset_baker/terrain_assets_tests",
                "client/runtime_media_tests",
                "client/lab_scene_tests",
                "client/terrain_tests",
                "client_diagnostics/showcase_storyboard_tests",
            ],
        ),
        (
            name: "captures",
            paths: ["assets/captures/**"],
            crates: ["client_diagnostics"],
        ),
        (
            // C15 to C20 and C24 read these files; `always` already runs the checks.
            name: "charter documents",
            paths: ["DESIGN.md", "AGENTS.md", "CLAUDE.md", "README.md", "docs/plans/README.md"],
            targets: ["workspace_checks/@fast"],
        ),
        (
            // The showcase cards and caption validation read DESIGN.md and the plan index.
            name: "showcase cards",
            paths: ["DESIGN.md", "docs/plans/README.md"],
            targets: ["client_diagnostics/showcase_storyboard_tests"],
        ),
    ],

    // Downstream contracts (blueprint section 4.3): the tests a change in a crate selects in its
    // reverse dependencies, beyond the crate's own.
    downstream: {
        "sim_types": [
            "sim_map/@fast",
            "sim_core/@fast",
            "sim_fixtures/@fast",
            "client/headless_tests",
            "client/pipeline_presentation_tests",
            "client/player_presentation_tests",
            "client/simulation_diagnostics_tests",
            "asset_baker/runtime_catalog_tests",
        ],
        "sim_map": [
            "sim_core/@fast",
            "sim_core/@slow",
            "sim_fixtures/@fast",
            "client/editor_core_tests",
            "client/editor_entity_placement_tests",
            "client/mesher_golden_tests",
            "client/runtime_battle_tests",
        ],
        // `skirmish_match_tests` is the whole-match proof through input: combat and economy
        // changes are what it exists to catch.
        "sim_core": [
            "sim_fixtures/@fast",
            "asset_baker/runtime_catalog_tests",
            "client/pipeline_presentation_tests",
            "client/player_presentation_tests",
            "client/simulation_diagnostics_tests",
            "client/battle_result_tests",
            "client/skirmish_match_tests",
            // Pins attack cycles of shipped weapons: weapon timing changes break it (WP11's delay).
            "client/battle_flipbook_tests",
        ],
        // Every target whose code calls `sim_fixtures::` (its own files or a support file it
        // loads); the catalog test keeps this list equal to the sources.
        "sim_fixtures": [
            "asset_baker/bake_integrity_tests",
            "asset_baker/procedural_tests",
            "asset_baker/provenance_tests",
            "asset_baker/runtime_catalog_tests",
            "asset_baker/veo_reliability_tests",
            "asset_baker/veo_tests",
            "client/lib",
            "client/battle_flipbook_tests",
            "client/editor_core_tests",
            "client/headless_tests",
            "client/round2_visual_tests",
            "client/skirmish_match_tests",
            "client_diagnostics/lib",
            "sim_core/acceleration_tests",
            "sim_core/attack_move_simulation_tests",
            "sim_core/attack_swing_snapshot_tests",
            "sim_core/attribute_bonus_tests",
            "sim_core/barrier_tests",
            "sim_core/catalog_reference_values_tests",
            "sim_core/catalog_serialization_compatibility",
            "sim_core/checked_movement_tests",
            "sim_core/checksum_state_tests",
            "sim_core/collision_and_immobility_tests",
            "sim_core/combat_correctness_tests",
            "sim_core/combat_retaliation_and_projectile_tests",
            "sim_core/construction_lifecycle_tests",
            "sim_core/damage_and_shields_tests",
            "sim_core/determinism_lockstep_tests",
            "sim_core/fixed_body_transactions_tests",
            "sim_core/flee_and_evasion_tests",
            "sim_core/fog_of_war_pathfinding_tests",
            "sim_core/full_match_tests",
            "sim_core/golden_replay_tests",
            "sim_core/harvest_income_tests",
            "sim_core/high_ground_combat_tests",
            "sim_core/hull_turning_tests",
            "sim_core/load_orders_tests",
            "sim_core/match_result_tests",
            "sim_core/movement_contact_tests",
            "sim_core/multi_strike_timing_tests",
            "sim_core/player_view_tests",
            "sim_core/production_timer_tests",
            "sim_core/production_transactions_tests",
            "sim_core/published_actions_tests",
            "sim_core/push_priority_tests",
            "sim_core/ramp_movement_tests",
            "sim_core/research_and_cancel_tests",
            "sim_core/research_transaction_tests",
            "sim_core/runtime_catalog_tests",
            "sim_core/sc2_battle_benchmarks_tests",
            "sim_core/sc2_who_wins_matchup_matrix_tests",
            "sim_core/scenario_tests",
            "sim_core/snapshot_output_tests",
            "sim_core/spells_and_abilities_tests",
            "sim_core/stutter_step_tests",
            "sim_core/target_selection_tests",
            "sim_core/turret_tracking_tests",
            "sim_core/upgrades_and_tech_tree_tests",
            "sim_core/watchtower_tick_tests",
            "sim_core/weapon_cadence_tests",
            "sim_core/weapon_catalog_rules_tests",
            "sim_core/weapon_period_tests",
        ],
        "asset_baker": [
            "client/runtime_media_tests",
            "client/runtime_assets_tests",
            "client/lab_scene_tests",
            "client_diagnostics/palette_fixture_tests",
        ],
        // Its `gpu` targets run by their triggers.
        "client": [
            "client_diagnostics/@fast",
        ],
    },

    // Extra commands of `package` (when a path matches) and `full` (always): the golden replay in
    // release and on wasm32-wasip1, and the wasm32-unknown-unknown check, as CI's determinism jobs
    // run them.
    commands: [
        (
            name: "golden-replay-release",
            paths: [
                "crates/{sim_types,sim_map,sim_core,sim_fixtures}/**",
                "assets/catalog/**",
                "assets/maps/**",
            ],
            program: "cargo",
            args: ["test", "-p", "sim_core", "--test", "golden_replay_tests", "--locked", "--release"],
        ),
        (
            name: "golden-replay-wasm32-wasip1",
            paths: [
                "crates/{sim_types,sim_map,sim_core,sim_fixtures}/**",
                "assets/catalog/**",
                "assets/maps/**",
            ],
            program: "cargo",
            args: ["test", "-p", "sim_core", "--test", "golden_replay_tests", "--target", "wasm32-wasip1", "--locked", "--release"],
            env: {"CARGO_TARGET_WASM32_WASIP1_RUNNER": "wasmtime"},
        ),
        (
            name: "check-wasm32-unknown-unknown",
            paths: ["crates/{sim_types,sim_map,sim_core}/**"],
            program: "cargo",
            args: ["check", "-p", "sim_types", "-p", "sim_map", "-p", "sim_core", "--target", "wasm32-unknown-unknown", "--locked"],
        ),
    ],
)
