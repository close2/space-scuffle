// Scenario table for `cargo bench -p sim_core --bench throughput`.
//
// Mirrors the attack-move throughput table in Appendix A of
// docs/plans/2026-11-01-codebase-remediation.md. Each run builds a flat map, splits
// `units` evenly between two players in opposite corners, orders both sides to
// attack-move across the map, and measures `ticks` steps of the real `SimWorld`. A row with
// `map_file` fights on that shipped map instead, between its first two start locations.
(
    unit_slug: "pulse_bot",
    seed: 7,
    ticks: 300,
    repeats: 3,
    scenarios: [
        (map_cells: 64, units: 0),
        (map_cells: 64, units: 100),
        (map_cells: 64, units: 400),
        (map_cells: 128, units: 400),
        (map_cells: 256, units: 0),
        // Terrain: the showcase canyon's ramps and plateau, 400 units marching between the
        // bases through the route planner (sc2 pathfinding WP8).
        (map_cells: 64, units: 400, map_file: Some("showcase_canyon.scmap.ron")),
        // Spells (plan 2026-11-10-spellcaster-mechanics WP6): the 64x64 battle of 400 units with
        // the first army's spellcasters casting at the second army throughout: Blinding Clouds
        // and Psionic Storms (live areas), Fungal Growths (missiles, two statuses per unit).
        // A cast needs the point in sight, so 250 warm ticks bring the armies together first;
        // then about 14 areas and 100 statuses are live on a measured tick, until the casters'
        // energy runs low (the benchmark prints the measured means). Casters wait below the first
        // army and fly or walk into cast range on their own.
        (
            map_cells: 64,
            units: 400,
            warm_ticks: 250,
            spells: [
                (caster_slug: "tongue_chameleon", ability: "Blinding Cloud", casters: 29, energy: 200,
                 every_ticks: 6, spread: 3),
                (caster_slug: "cerebral_elder", ability: "Psionic Storm", research: Some("psionic_storm"),
                 casters: 19, energy: 200, every_ticks: 12, spread: 3),
                (caster_slug: "mycelium_shaman", ability: "Fungal Growth", casters: 19, energy: 200,
                 every_ticks: 10, spread: 2),
            ],
        ),
        // Hangars (plan 2026-11-28-carrier-interceptors §5): the 64x64 battle of 200 units with
        // 12 of the first hangar unit of the catalog (found by property) attack-moving with the
        // first army, about 100 launched members at full magazines; 250 warm ticks bring the
        // armies together, and the measured ticks include launches, fights, docks and rebuilds.
        (map_cells: 64, units: 200, warm_ticks: 250, hangar_units: 12),
        // Brood (plan 2026-11-28-broodlings §5): the 64x64 battle of 200 units with 12 of the
        // first unit of the catalog with a strike magazine and an impact spawn (found by
        // property) attack-moving with the first army; 250 warm ticks bring the armies together,
        // and the measured ticks include releases, spawns, clocks and expiries.
        (map_cells: 64, units: 200, warm_ticks: 250, spawner_units: 12),
        // Razed (plan 2026-12-01-death-spawns-and-hangar-commands §5, re-designed by its WPA4):
        // the 64x64 battle of 100 units with 12 structures of the second player that leave the
        // most timed units when they die (found by property: 9 Broodlings each) standing in the
        // first army's path; 250 warm ticks bring the first army to them, and the measured ticks
        // include their deaths, the bursts of created units, their fights, clocks and expiries.
        // At 200 units the twelve 5x5 structures made a measured tick cost 90.0 M instructions,
        // above the 400-unit row's 54.4 M; at 100 it costs 38.1 M.
        (map_cells: 64, units: 100, warm_ticks: 250, razed_structures: 12),
    ],
)
