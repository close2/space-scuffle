// Scenario table for `cargo bench -p sim_core --bench throughput`.
//
// Mirrors the attack-move throughput table in Appendix A of
// docs/plans/2026-11-01-codebase-remediation.md. Each run builds a flat map, splits
// `units` evenly between two players in opposite corners, orders both sides to
// attack-move across the map, and measures `ticks` steps of the real `SimWorld`. A row with
// `map_file` fights on that shipped map instead, between its first two start locations.
(
    unit_slug: "pulse_bot",
    seed: 7,
    ticks: 300,
    repeats: 3,
    scenarios: [
        (map_cells: 64, units: 0),
        (map_cells: 64, units: 100),
        (map_cells: 64, units: 400),
        (map_cells: 128, units: 400),
        (map_cells: 256, units: 0),
        // Terrain: the showcase canyon's ramps and plateau, 400 units marching between the
        // bases through the route planner (sc2 pathfinding WP8).
        (map_cells: 64, units: 400, map_file: Some("showcase_canyon.scmap.ron")),
        // Spells (plan 2026-11-10-spellcaster-mechanics WP6): the 64x64 battle of 400 units with
        // the first army's spellcasters casting at the second army throughout: Blinding Clouds
        // and Psionic Storms (live areas), Fungal Growths (missiles, two statuses per unit).
        // After 150 warm ticks about 20 areas and over 100 statuses are live on every measured
        // tick; the benchmark prints the measured means. Casters wait below the first army and
        // fly or walk into cast range on their own.
        (
            map_cells: 64,
            units: 400,
            warm_ticks: 150,
            spells: [
                (caster_slug: "tongue_chameleon", ability: "Blinding Cloud", casters: 29, energy: 200,
                 every_ticks: 8, spread: 3),
                (caster_slug: "cerebral_elder", ability: "Psionic Storm", research: Some("psionic_storm"),
                 casters: 19, energy: 200, every_ticks: 12, spread: 3),
                (caster_slug: "mycelium_shaman", ability: "Fungal Growth", casters: 19, energy: 200,
                 every_ticks: 12, spread: 2),
            ],
        ),
    ],
)
