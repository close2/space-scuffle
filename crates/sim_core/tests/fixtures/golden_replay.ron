    checksum_schema: 7,
    seed: 0x5EED_0F_5CAFF1E,
    total_ticks: 1000,
    checkpoint_interval: 50,
    squads: [
        (name: "blue_infantry", player: 0, slug: "pulse_bot", count: 16, origin: (18, 10), columns: 8),
        (name: "blue_armor", player: 0, slug: "rhino_beetle", count: 4, origin: (24, 6), columns: 4),
        (name: "red_psi", player: 1, slug: "psi_grey", count: 12, origin: (40, 48), columns: 6),
        (name: "red_siege", player: 1, slug: "railgun_crawler", count: 3, origin: (36, 44), columns: 3),
    ],
    structures: [
        (player: 0, slug: "foundry_core_dome", cell: (6, 6)),
        (player: 1, slug: "foundry_core_dome", cell: (52, 52)),
    ],
    orders: [
