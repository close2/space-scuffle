// Golden lockstep replay: a real battle on the shipped default arena, with the world
// checksum recorded every `checkpoint_interval` ticks.
//
// Every target (Linux, Windows, macOS ARM64, wasm32-wasip1) replays this script and must
// reproduce `checksums` exactly. A simulation change that alters behaviour updates this
// list in the commit that explains why. See tests/golden_replay_tests.rs.
// Re-recorded for plan 2026-11-04-combat-sc2-alignment WP4 (Q0036): "red_psi" (psi_grey) now
// swings with damage point 0, every 21 ticks, range 0.1, backswing 9 (was 4, 22, 0.3, 6).
// Checkpoints 1 to 4 (ticks 1 to 200) are unchanged; from checkpoint 5 (ticks 201 to 250), the
// first in which the zealot weapon matters, every checkpoint changed.
(
    checksum_schema: 9,
    seed: 0x5EED_0F_5CAFF1E,
    total_ticks: 1000,
    checkpoint_interval: 50,
    squads: [
        (name: "blue_infantry", player: 0, slug: "pulse_bot", count: 16, origin: (18, 10), columns: 8),
        (name: "blue_armor", player: 0, slug: "rhino_beetle", count: 4, origin: (24, 6), columns: 4),
        (name: "red_psi", player: 1, slug: "psi_grey", count: 12, origin: (40, 48), columns: 6),
        (name: "red_siege", player: 1, slug: "railgun_crawler", count: 3, origin: (36, 44), columns: 3),
    ],
    research: [(player: 0, upgrade: "overclock_stim")],
    structures: [
        (player: 0, slug: "foundry_core_dome", cell: (6, 6)),
        (player: 1, slug: "foundry_core_dome", cell: (52, 52)),
    ],
    orders: [
        (tick: 5, squads: ["blue_infantry", "blue_armor"], order: AttackMove(32, 46)),
        (tick: 40, squads: ["red_psi"], order: AttackMove(32, 20)),
        (tick: 120, squads: ["red_siege"], order: AttackMove(32, 28)),
        (tick: 260, squads: ["blue_infantry"], order: UseStim),
        (tick: 400, squads: ["blue_armor"], order: Move(20, 12)),
        (tick: 520, squads: ["blue_armor"], order: AttackMove(32, 46)),
        (tick: 640, squads: ["red_psi"], order: HoldPosition),
        (tick: 760, squads: ["red_psi", "red_siege"], order: Stop),
    ],
    checksums: [
        0xdadf1445e48a13fe,
        0xefd17a4dfe28f45c,
        0x5c319da929211968,
        0x12352d59140cc554,
