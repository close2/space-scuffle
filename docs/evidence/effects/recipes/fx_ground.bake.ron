// Bake recipe of the `fx_ground` set (plan docs/plans/2026-11-09-effect-visualization.md §6.3,
// WP6a): `asset_baker effect-bake --recipe <this file> --sources-dir <dir holding the sources>
// --ledger docs/evidence/veo/ledger.jsonl --output-dir assets/effects`.
//
// Sources are named by their bare file names; each is cited by its ledger line in
// assets/effects/fx_ground.provenance.ron. Review: docs/evidence/effects/review/texture_review.md.
// - chitin_clump (review round 3, Amendment 2): three generated stills side-on, each a clump of
//   three to five straight, tapering chitin spikes splayed outward from one shared base (a fan
//   of four, an uneven five, an uneven three); silhouette key (`Solid`) so the dark umber
//   bodies stay opaque; variants. Replaces round 2's curved single spines as the clump at each
//   search point, which the round-2 review read as handwritten glyphs.
// - chitin_spine (review round 3): two generated stills side-on, one straight spike each (a
//   tall slender one, a short thick thorn), silhouette key; variants. The single spikes that
//   lean out beside each clump. Round 2's curved claw, hook, thorn and S-curve are dropped.
// - spine_crack (review round 2, round 3): the elongated rupture of round 2 and, from round 3,
//   a second narrow rupture; the round-2 torn hole (a donut ring) and radial star are dropped,
//   because the round-2 review read the leftover marks as a stencil row of stars and rings.
// - ground_crack: two generated stills, top-down, a crack tapering to hairlines at both ends,
//   so segments chain along a line with overlap; variants, one layer each.
// - earth_scar (review round 3): generated stills, top-down, a ragged furrow of torn,
//   upturned earth running across the frame and fading out at both ends; luminance key
//   (`Lit`); variants. Stretched along the line and overlapping, the pieces merge into one
//   broken scar.
(
    set: "fx_ground",
    cell_size: 256,
    elements: [
        (
            name: "chitin_clump",
            look: Solid,
            source: Variants(pictures: [
                Still(file: "fx_ground.chitin_clump.20261110T183137Z-480898-1.on_black.png"),
                Still(file: "fx_ground.chitin_clump.20261110T183204Z-483667-1.on_black.png"),
                Still(file: "fx_ground.chitin_clump.20261110T183231Z-486319-1.on_black.png"),
            ]),
        ),
        (
            name: "chitin_spine",
            look: Solid,
            source: Variants(pictures: [
                Still(file: "fx_ground.chitin_spine.20261110T183253Z-490421-1.on_black.png"),
                Still(file: "fx_ground.chitin_spine.20261110T183308Z-492397-1.on_black.png"),
            ]),
        ),
        (
            name: "spine_crack",
            look: Lit,
            source: Variants(pictures: [
                Still(file: "fx_ground.spine_crack.20261110T092204Z-1171787-1.on_black.png"),
                Still(file: "fx_ground.spine_crack.20261110T183532Z-508826-1.on_black.png"),
            ]),
        ),
        (
            name: "ground_crack",
            look: Lit,
            source: Variants(pictures: [
                Still(file: "fx_ground.ground_crack.20261110T004422Z-2247765-1.on_black.png"),
                Still(file: "fx_ground.ground_crack.20261110T004525Z-2253706-1.on_black.png"),
            ]),
        ),
        (
            name: "earth_scar",
            look: Lit,
            source: Variants(pictures: [
                Still(file: "fx_ground.earth_scar.20261110T183323Z-494472-1.on_black.png"),
                Still(file: "fx_ground.earth_scar.20261110T183413Z-500158-1.on_black.png"),
            ]),
        ),
    ],
)
