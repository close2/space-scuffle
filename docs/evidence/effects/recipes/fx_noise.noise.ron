// Noise recipe of the `fx_noise` set (plan docs/plans/2026-11-09-effect-visualization.md §6.3,
// WP6a): `asset_baker effect-noise --recipe <this file> --output-dir assets/effects`.
//
// Authored data, regenerated byte for byte from these parameters by the integrity test.
// - noise_tile: R Perlin (soft clouds), G inverted Worley (cells, for acid and crackle),
//   B and A the two curl components of one potential (distortion and smoke flow). Tiles.
// - ring_noise: R a soft ring mask (shockwave band), G Perlin and B Worley to break it up.
// - fire_noise: R fine Perlin, G value noise, B inverted Worley; flicker and fire breakup.
//   Tiles.
// - erosion_gradient: three radial erosion gradients of rising raggedness (R mild, G strong,
//   B smooth) for decals that dissolve from the rim inwards.
(
    set: "fx_noise",
    cell_size: 256,
    elements: [
        (name: "noise_tile", channels: (
            r: Perlin((seed: 101, period: 4, octaves: 5, gain_permille: 500)),
            g: Worley(seed: 102, cells: 8, invert: true),
            b: Curl(potential: (seed: 103, period: 3, octaves: 3, gain_permille: 500), component: X),
            a: Curl(potential: (seed: 103, period: 3, octaves: 3, gain_permille: 500), component: Y),
        )),
        (name: "ring_noise", channels: (
            r: RingMask(inner_permille: 700, outer_permille: 880, softness_permille: 60),
            g: Perlin((seed: 201, period: 8, octaves: 4, gain_permille: 550)),
            b: Worley(seed: 202, cells: 12, invert: false),
            a: Constant(255),
        )),
        (name: "fire_noise", channels: (
            r: Perlin((seed: 301, period: 6, octaves: 6, gain_permille: 550)),
            g: Value((seed: 302, period: 8, octaves: 5, gain_permille: 500)),
            b: Worley(seed: 303, cells: 6, invert: true),
            a: Constant(255),
        )),
        (name: "erosion_gradient", channels: (
            r: ErosionGradient(noise: (seed: 401, period: 4, octaves: 4, gain_permille: 500), noise_permille: 250),
            g: ErosionGradient(noise: (seed: 402, period: 6, octaves: 5, gain_permille: 550), noise_permille: 400),
            b: ErosionGradient(noise: (seed: 403, period: 3, octaves: 3, gain_permille: 450), noise_permille: 150),
            a: Constant(255),
        )),
    ],
)
