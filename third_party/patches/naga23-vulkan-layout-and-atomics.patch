+    /// Returns a buffer-interface pointee when a load/store crosses a layout boundary.
+    fn interface_pointee(&self, pointer: Handle<crate::Expression>) -> Option<Handle<crate::Type>> {
+        match *self.fun_info[pointer].ty.inner_with(&self.ir_module.types) {
+            crate::TypeInner::Pointer {
+                base,
+                space:
+                    crate::AddressSpace::Uniform
+                    | crate::AddressSpace::Storage { .. }
+                    | crate::AddressSpace::PushConstant,
+            } => Some(base),
+            _ => None,
+        }
+    }
+
+    /// Converts composite values without changing scalar bits or buffer layout.
+    fn convert_layout(
+        &mut self,
+        ty: Handle<crate::Type>,
+        value: Word,
+        to_interface: bool,
+        block: &mut Block,
+    ) -> Word {
+        let logical = self.get_type_id(LookupType::Handle(ty));
+        let interface = self.get_type_id(LookupType::Interface(ty));
+        if logical == interface {
+            return value;
+        }
+        // The validator forbids loading/storing unsized values. After the ID
+        // equality check, only sized arrays/structures can need conversion:
+        // scalar/vector/matrix types share IDs and unsized blocks alias IDs.
+        let children: Vec<_> = match &self.ir_module.types[ty].inner {
+            crate::TypeInner::Array {
+                base,
+                size: crate::ArraySize::Constant(length),
+                ..
+            } => vec![*base; length.get() as usize],
+            crate::TypeInner::Struct { members, .. } => {
+                members.iter().map(|member| member.ty).collect()
+            }
+            _ => unreachable!("Only sized composite values cross an interface layout boundary"),
+        };
+        let mut values = Vec::with_capacity(children.len());
+        for (index, child) in children.into_iter().enumerate() {
+            let source_type = self.get_type_id(if to_interface {
+                LookupType::Handle(child)
+            } else {
+                LookupType::Interface(child)
+            });
+            let extracted = self.gen_id();
+            block.body.push(Instruction::composite_extract(
+                source_type,
+                extracted,
+                value,
+                &[index as u32],
+            ));
+            values.push(self.convert_layout(child, extracted, to_interface, block));
+        }
+        let result = self.gen_id();
+        block.body.push(Instruction::composite_construct(
+            if to_interface { interface } else { logical },
+            result,
+            &values,
+        ));
+        result
+    }
