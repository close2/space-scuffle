+/// Explicit layout is required only for host-visible buffer interfaces.
+fn interface_storage_class(class: spirv::StorageClass) -> bool {
+    matches!(
+        class,
+        spirv::StorageClass::Uniform
+            | spirv::StorageClass::StorageBuffer
+            | spirv::StorageClass::PushConstant
+    )
