+    /// Creates the host-visible type variant separately from logical values.
+    /// Buffer layout decorations must never leak into workgroup/private variables.
+    fn write_interface_type(
+        &mut self,
+        arena: &UniqueArena<crate::Type>,
+        handle: Handle<crate::Type>,
+    ) -> Result<(), Error> {
+        let logical = self.get_type_id(LookupType::Handle(handle));
+        let id = match &arena[handle].inner {
+            crate::TypeInner::Array { base, size, stride } => {
+                let id = self.id_gen.next();
+                let base_id = self.get_type_id(LookupType::Interface(*base));
+                self.decorate(id, spirv::Decoration::ArrayStride, &[*stride]);
+                let instruction = match *size {
+                    crate::ArraySize::Constant(length) => {
+                        let length_id = self.get_index_constant(length.get());
+                        Instruction::type_array(id, base_id, length_id)
+                    }
+                    crate::ArraySize::Dynamic => Instruction::type_runtime_array(id, base_id),
+                };
+                instruction.to_words(&mut self.logical_layout.declarations);
+                id
+            }
+            crate::TypeInner::Struct { members, .. } => {
+                let interface_only = members.last().is_some_and(|member| {
+                    matches!(
+                        arena[member.ty].inner,
+                        crate::TypeInner::Array {
+                            size: crate::ArraySize::Dynamic,
+                            ..
+                        }
+                    )
+                });
+                if interface_only {
+                    logical
+                } else {
+                    let id = self.id_gen.next();
+                    let mut member_ids = Vec::with_capacity(members.len());
+                    for (index, member) in members.iter().enumerate() {
+                        self.decorate_struct_member(id, index, member, arena)?;
+                        member_ids.push(self.get_type_id(LookupType::Interface(member.ty)));
+                    }
+                    Instruction::type_struct(id, &member_ids)
+                        .to_words(&mut self.logical_layout.declarations);
+                    id
+                }
+            }
+            _ => logical,
+        };
+        self.lookup_type.insert(LookupType::Interface(handle), id);
+        Ok(())
     }
 
